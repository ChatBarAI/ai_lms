- course = enrollment.course
- access_available = course_access_available?(course)
- completed = course_completed?(course)
- average_score = enrollment.average_score
%article.overflow-hidden.rounded-xl.border.border-gray-200.bg-white.shadow-sm
  .grid.grid-cols-1.items-start.gap-6.p-5.sm:p-6.lg:grid-cols-3.lg:gap-8
    .min-w-0.lg:col-span-2
      .flex.flex-wrap.items-center.gap-x-3.gap-y-2
        %h2.min-w-0.text-xl.font-semibold.leading-snug.break-words
          = link_to course.title, course_path(course), class: "hover:text-indigo-600 focus-visible:ring-2 focus-visible:ring-indigo-500 rounded"
        - if completed
          = render "learning/completion_badge"
        - else
          %span.rounded-full.bg-indigo-50.dark:bg-indigo-950.px-3.py-1.text-xs.font-semibold.text-indigo-700= percentage.positive? ? t("home.me.in_progress") : t("home.me.not_started")

      - unless access_available
        %p.mt-3.text-amber-700= t("payments.access_required")
      - if enrollment.archived_at
        %p.mt-3.text-gray-600= t("payments.archived")
      .mt-4.grid.grid-cols-1.items-start.gap-5.sm:grid-cols-2.sm:gap-8
        %div
          .flex.items-center.justify-between.gap-3.text-sm
            %span.text-gray-500= t("home.me.progress")
            %span.font-semibold.tabular-nums= "#{number_with_precision(percentage, precision: 1, strip_insignificant_zeros: true)}%"
          .mt-3.h-2.overflow-hidden.rounded-full.bg-gray-100{ role: "progressbar", "aria-label": t("home.me.progress"), "aria-valuenow": percentage, "aria-valuemin": 0, "aria-valuemax": 100 }
            %div.h-full.rounded-full{ class: completed ? "bg-emerald-500" : "bg-indigo-500", style: "width: #{percentage.clamp(0, 100)}%" }
          %p.mt-3.text-xs.text-gray-500
            %span.font-semibold.tabular-nums.text-gray-700= "#{enrollment.lessons_completed_count} / #{enrollment.lessons_required_count}"
            = t("home.me.lessons_completed", **terms)
        %div
          %p.text-sm.text-gray-500= t("home.me.avg_score")
          %p.mt-2.text-2xl.font-semibold.tabular-nums
            = average_score ? "#{number_with_precision(average_score, precision: 1, strip_insignificant_zeros: true)}%" : "—"
    .min-w-0
      %p.mb-2.text-sm.text-gray-500= t("home.me.quiz_trend", **terms)
      - if attempts.size > 1
        = render "shared/quiz_trend_popup",
                 attempts: attempts,
                 pass_mark: pass_mark,
                 dialog_id: "my-learning-trend-#{enrollment.id}",
                 title: t("home.me.quiz_trend_title", quiz: terms[:quiz], course: course.title, lessons: terms[:lessons]),
                 button_class: "w-full rounded-lg border border-gray-200 px-3 py-2 text-left cursor-zoom-in hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-indigo-500",
                 mini_svg_class: "h-12 w-full"
        %p.mt-1.text-xs.text-gray-500= t("home.me.expand_trend")
      - else
        %p.text-sm.text-gray-500= t("home.me.trend_empty", **terms)

  - if certificate_available?(course)
    = render "learning/certificate_footer", course: course, enrollment: enrollment, show_completion_details: true, summary_id: "completion-summary-#{enrollment.id}"
