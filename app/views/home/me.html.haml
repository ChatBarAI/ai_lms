- content_for :title, t(".title")

.mb-8.flex.flex-wrap.items-end.justify-between.gap-4
  %div
    %h1.text-3xl.font-bold.tracking-tight= t(".heading")
    %p.mt-2.text-sm.text-gray-500= t(".subtitle")
  = link_to t(".browse_courses", **terms), courses_path, class: "inline-flex items-center justify-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-indigo-500"

- if @enrollments.empty?
  .bg-white.border.border-gray-200.rounded-xl.p-8.text-center
    %p.text-gray-600= t(".not_enrolled", **terms)
- else
  .space-y-5.mb-10
    - @enrollments.each do |enrollment|
      = render "enrollment_card", enrollment: enrollment, percentage: @completion_percentages.fetch(enrollment.id), attempts: @quiz_attempts_by_enrollment[enrollment.id] || [], pass_mark: @default_pass_mark

  .grid.grid-cols-1.gap-6.lg:grid-cols-2
    .min-w-0.rounded-xl.border.border-gray-200.bg-white.p-5.sm:p-6
      %h2.font-semibold= t(".course_completion", **terms)
      %p.mt-1.text-xs.text-gray-500= t(".course_completion_hint", **terms)
      .mt-6.space-y-5
        - @enrollments.each do |enrollment|
          - percentage = @completion_percentages.fetch(enrollment.id)
          %div
            .mb-2.flex.items-baseline.justify-between.gap-4.text-sm
              = link_to enrollment.course.title, course_path(enrollment.course), class: "min-w-0 break-words font-medium hover:text-indigo-600"
              %span.shrink-0.tabular-nums.text-gray-500= "#{number_with_precision(percentage, precision: 1, strip_insignificant_zeros: true)}%"
            .h-2.overflow-hidden.rounded-full.bg-gray-100
              .h-full.rounded-full.bg-indigo-500{ style: "width: #{percentage.clamp(0, 100)}%" }

    .min-w-0.rounded-xl.border.border-gray-200.bg-white.p-5.sm:p-6
      %h2.font-semibold= t(".lessons_per_week", **terms)
      %p.mt-1.mb-4.text-xs.text-gray-500= t(".last_12_weeks")
      = svg_chart @completed_per_week, type: :line, color: "#10b981", height: 180
