- drawer_id = "lesson-course-sidebar"
- title_id = "lesson-course-sidebar-title"

%button.inline-flex.items-center.rounded-full.border.border-indigo-200.bg-indigo-100.px-3.py-1.text-xs.font-medium.text-indigo-700.transition-colors.hover:bg-indigo-200.cursor-pointer.dark:border-indigo-700.dark:bg-indigo-950.dark:text-indigo-200.dark:hover:bg-indigo-900{ class: "gap-1.5", type: "button", data: { action: "lesson-sidebar#toggle", lesson_sidebar_target: "openButton" }, "aria-controls": drawer_id, "aria-expanded": "false" }
  %svg{ class: "w-3.5 h-3.5", xmlns: "http://www.w3.org/2000/svg", fill: "none", viewbox: "0 0 24 24", stroke: "currentColor", "stroke-width": "2", "aria-hidden": "true" }
    %path{ "stroke-linecap": "round", "stroke-linejoin": "round", d: "M4 6h16M4 12h16M4 18h16" }
  = t("lessons.course_sidebar.open")

.lesson-sidebar-overlay.fixed.inset-0.z-50.invisible.pointer-events-none{ id: drawer_id, role: "dialog", "aria-modal": "true", "aria-labelledby": title_id, "aria-hidden": "true", data: { lesson_sidebar_target: "overlay" } }
  .lesson-sidebar-backdrop.absolute.inset-0.opacity-0.transition-opacity.duration-300{ class: "bg-gray-900/50", data: { action: "click->lesson-sidebar#close", lesson_sidebar_target: "backdrop" } }
  %aside.lesson-sidebar-panel.absolute.inset-y-0.left-0.flex.w-full.max-w-sm.-translate-x-full.transform.flex-col.bg-white.shadow-2xl.transition-transform.duration-300.dark:bg-gray-900{ tabindex: "-1", data: { lesson_sidebar_target: "panel" } }
    .flex.items-start.justify-between.gap-4.border-b.border-gray-200.p-5.dark:border-gray-700
      .min-w-0
        %p.text-xs.font-semibold.uppercase.tracking-wide.text-indigo-600= t("lessons.course_sidebar.course", course_l: terms[:course_l])
        %h2.mt-1.text-xl.font-bold.text-gray-900.dark:text-gray-100{ id: title_id }= @course.title
      %button.w-8.h-8.inline-flex.items-center.justify-center.rounded-full.bg-red-500.hover:bg-red-600.text-white.cursor-pointer.transition-colors.focus:outline-none.focus-visible:ring-2.focus-visible:ring-red-400.focus-visible:ring-offset-1{ type: "button", data: { action: "lesson-sidebar#close", lesson_sidebar_target: "closeButton" }, "aria-label": t("lessons.course_sidebar.close") }
        %svg{ xmlns: "http://www.w3.org/2000/svg", viewbox: "0 0 24 24", fill: "none", stroke: "currentColor", "stroke-width": "2.5", "stroke-linecap": "round", "stroke-linejoin": "round", width: "16", height: "16", "aria-hidden": "true" }
          %line{ x1: "18", y1: "6", x2: "6", y2: "18" }
          %line{ x1: "6", y1: "6", x2: "18", y2: "18" }

    .flex-1.overflow-y-auto
      - if @course.cover_image.attached?
        = image_tag @course.cover_image, class: "h-40 w-full object-cover", alt: ""

      .border-b.border-gray-200.p-5.dark:border-gray-700
        - if subjects_enabled? && @course.subject
          %p.text-sm.font-medium.text-gray-600.dark:text-gray-300= @course.subject.name
        - if @course.description.present?
          %p.mt-2.text-sm.leading-5.text-gray-600.dark:text-gray-400= truncate(@course.description, length: 180)

        - if @enrollment
          .mt-4
            .flex.items-center.justify-between.text-xs.font-medium.text-gray-600.dark:text-gray-300{ class: "mb-1.5" }
              %span= t("lessons.course_sidebar.progress")
              %span= t("lessons.course_sidebar.percent_complete", percent: @course_progress_percentage)
            .h-2.overflow-hidden.rounded-full.bg-gray-200.dark:bg-gray-700{ role: "progressbar", "aria-label": t("lessons.course_sidebar.progress"), "aria-valuemin": "0", "aria-valuemax": "100", "aria-valuenow": @course_progress_percentage }
              .h-full.rounded-full.bg-indigo-600{ style: "width: #{@course_progress_percentage}%" }

      %nav.p-3{ "aria-label": t("lessons.course_sidebar.lesson_navigation", lessons: terms[:lessons]) }
        %p.px-2.pb-2.pt-1.text-xs.font-semibold.uppercase.tracking-wide.text-gray-500= terms[:lessons]
        .space-y-2{ data: { controller: "lesson-accordion" } }
          - @course_lessons.each_with_index do |lesson, index|
            - current = lesson == @lesson
            - progress = @lesson_progress_by_id[lesson.id]
            - item_classes = current ? "border-indigo-200 bg-indigo-50 text-indigo-900 dark:border-indigo-800 dark:bg-indigo-950 dark:text-indigo-100" : "border-gray-200 bg-white text-gray-700 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-300"
            - panel_id = "lesson-sidebar-details-#{lesson.id}"
            .overflow-hidden.rounded-lg.border{ class: item_classes }
              .flex.w-full.items-stretch
                = link_to course_lesson_path(@course, lesson), class: "flex min-w-0 flex-1 items-start gap-3 px-3 py-2.5 transition-colors hover:bg-black/5 dark:hover:bg-white/5", "aria-current": (current ? "page" : nil) do
                  %span.flex.h-6.w-6.shrink-0.items-center.justify-center.rounded-full.text-xs.font-semibold{ class: (current ? "bg-indigo-600 text-white" : "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300") }= index + 1
                  .min-w-0.flex-1
                    .flex.items-start.gap-2
                      .flex.flex-1.flex-wrap.items-baseline.gap-x-2
                        %span.text-sm.font-medium.leading-5= lesson.title
                        - if lesson.duration_minutes.present?
                          %span.text-xs.font-normal.text-gray-500.dark:text-gray-400= t("lessons.course_sidebar.duration", count: lesson.duration_minutes)
                      - unless lesson.published?
                        %span.shrink-0.rounded.bg-amber-100.text-xs.text-amber-800{ class: "px-1.5 py-0.5" }= t("common.draft")
                  - if @enrollment
                    - if progress&.completed?
                      %span.shrink-0.text-green-600{ title: t("lessons.course_sidebar.completed"), "aria-label": t("lessons.course_sidebar.completed") } ✓
                    - elsif progress&.in_progress?
                      %span.shrink-0.text-indigo-600{ title: t("lessons.course_sidebar.in_progress"), "aria-label": t("lessons.course_sidebar.in_progress") } ●
                    - else
                      %span.shrink-0.text-gray-400{ title: t("lessons.course_sidebar.not_started"), "aria-label": t("lessons.course_sidebar.not_started") } ○
                %button.my-auto.mr-2.rounded.p-1.text-gray-400.transition-colors.hover:text-gray-700.cursor-pointer.dark:hover:text-gray-200{ class: "hover:bg-black/5 dark:hover:bg-white/5", type: "button", data: { action: "lesson-accordion#toggle", lesson_accordion_target: "button" }, "aria-controls": panel_id, "aria-expanded": current.to_s, "aria-label": t("lessons.course_sidebar.details_for", title: lesson.title) }
                  %svg.h-4.w-4.transition-transform{ class: (current ? "rotate-180" : ""), xmlns: "http://www.w3.org/2000/svg", fill: "none", viewbox: "0 0 24 24", stroke: "currentColor", "stroke-width": "2", "aria-hidden": "true", data: { lesson_accordion_chevron: true } }
                    %path{ "stroke-linecap": "round", "stroke-linejoin": "round", d: "m6 9 6 6 6-6" }

              .border-t.border-gray-200.p-3.dark:border-gray-700{ id: panel_id, class: (current ? "" : "hidden"), data: { lesson_accordion_target: "panel" } }
                - if lesson.cover_image.attached?
                  = image_tag lesson.cover_image, class: "mb-3 h-28 w-full rounded-md object-cover", alt: ""
                - if lesson.body.present?
                  %p.text-xs.leading-5.text-gray-600.dark:text-gray-400= truncate(lesson.body.to_plain_text.squish, length: 150)
                - if lesson.tags.any?
                  .mt-3.flex.flex-wrap.gap-1
                    - lesson.tags.each do |tag|
                      %span.inline-flex.items-center.rounded-full.px-2.text-xs.font-medium{ class: "py-0.5", style: "background-color: #{tag.color}; color: #{tag.text_color}" }= tag.name

    .border-t.border-gray-200.p-4.dark:border-gray-700
      = link_to course_path(@course), class: "flex w-full items-center justify-center rounded-lg border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" do
        = t("lessons.course_sidebar.back", course_l: terms[:course_l])
