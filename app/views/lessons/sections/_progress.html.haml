- if @enrollment
  .bg-white.border.border-gray-200.rounded-lg.p-4.mb-6{ id: "lesson-status" }
    - status_chart_dialog_id = "status-chart-dialog-#{@progress.id}"
    .flex.flex-wrap.items-center.gap-6
      .flex.items-center.gap-3
        = lesson_progress_ring(@progress, classes: "shrink-0 text-gray-700")
        %div
          %p.text-xs.font-medium.text-gray-600.dark:text-gray-300
            %span.block= terms[:lesson]
            %span.block= t("lessons.show.progress_label")
      - if @lesson.questions.any? || @quiz_attempts.present?
        .min-w-0.flex-1.border-l.border-gray-200.pl-6
          .flex.flex-wrap.items-center.gap-x-6.gap-y-3
            %div
              .flex.flex-wrap.items-baseline.gap-x-4.gap-y-1.mb-1
                %h2.font-semibold.text-sm= t("lessons.show.quiz_results", **terms)
                - if @quiz_attempts.present?
                  %p.text-xs.text-gray-500= t("lessons.show.attempts", count: @quiz_attempts.count)
              - if @ai_scoring_pending
                .flex.items-center.gap-1.5{ data: { controller: "scoring-channel", "scoring-channel-progress-id-value": @progress.id } }
                  .w-2.h-2.rounded-full.bg-indigo-500.animate-pulse
                  %p.text-xs.text-indigo-600.font-medium Queued for marking…
              - elsif @manual_marking_pending
                .flex.items-center.gap-1.5
                  .w-2.h-2.rounded-full.bg-amber-500
                  %p.text-xs.text-amber-700.font-medium Awaiting manual marking…
              - elsif @progress.score.present?
                %p.text-sm.text-gray-600= t("lessons.show.score", score: @progress.score.to_f.round(1), **terms)
              - unless @quiz_attempts.present?
                %p.text-xs.text-gray-500= t("lessons.show.no_attempts")
            - if @quiz_attempts.present? && @quiz_attempts.size > 1
              %div{ class: "w-52 max-w-full" }
                = render "shared/quiz_trend_popup",
                         attempts: @quiz_attempts,
                         pass_mark: @lesson.effective_pass_mark,
                         dialog_id: status_chart_dialog_id,
                         title: t("lessons.show.quiz_scores", **terms),
                         mini_svg_class: "h-10 w-full",
                         pass_mark_caption: true,
                         show_attempt_numbers: true,
                         axis_label: "Attempt Number"
      - if @progress.completed?
        .flex.flex-col.items-end.gap-2.self-center.ml-auto
          %span.text-sm.font-medium.text-green-700= t("lessons.show.completed")
          - if @enrollment.fully_completed?
            = link_to "Download Certificate", course_certificate_path(@course), class: "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-600 text-white hover:bg-green-700 transition-colors"
      - elsif @lesson.questions.none? && !@marking_pending
        .self-center.ml-auto
          = form_with model: @progress, url: progress_path(@progress.id), method: :patch, local: true do |f|
            = f.hidden_field :status, value: "completed"
            = f.submit t("lessons.show.mark_complete"), data: { turbo_confirm: t("lessons.show.confirm_mark_complete", **terms) }, class: "px-3 py-1.5 rounded bg-green-600 text-white hover:bg-green-700 cursor-pointer text-sm"
