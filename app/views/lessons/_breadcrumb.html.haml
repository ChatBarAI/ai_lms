-# locals: course, lesson, lessons (Array of Lesson, same list as the Progress sidebar)
- position = lesson_position_label(lesson, lessons)
- subject = course.subject
%nav#lesson-breadcrumb.min-w-0.text-sm.text-gray-600.dark:text-gray-300{ "aria-label": t("lessons.breadcrumb.label") }
  %ol.flex.flex-wrap.items-center.gap-x-2.gap-y-1
    - if subjects_enabled? && subject && can?(:read, subject)
      %li.flex.items-center.gap-2
        = link_to subject.name, subject_path(subject), class: "hover:text-indigo-700 hover:underline"
        %span.text-gray-400{ "aria-hidden": "true" } ›
    %li.flex.items-center.gap-2
      = link_to course.title, course_path(course), class: "hover:text-indigo-700 hover:underline"
      %span.text-gray-400{ "aria-hidden": "true" } ›
    %li.font-medium.text-gray-900.dark:text-gray-100{ "aria-current": "page" }
      - if position
        %span= position
        %span.text-gray-400{ "aria-hidden": "true" } ·
      %span= lesson.title
