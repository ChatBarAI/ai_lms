- content_for :title, t("catalog_ui.needs_marking", **terms)
- content_for :head do
  -# Scoring redirects back here; morph + preserve scroll keeps the marker's place.
  = turbo_refreshes_with method: :morph, scroll: :preserve
- queue_path = admin_report_context? ? admin_marking_queue_path : marking_queue_path
- secondary_button = "px-3 py-1.5 rounded bg-gray-100 text-gray-800 hover:bg-gray-200 border border-gray-200 text-sm"

.flex.flex-wrap.items-start.justify-between.gap-3.mb-6
  %div
    %h1.text-2xl.font-bold= t("catalog_ui.needs_marking", **terms)
    %p.text-sm.text-gray-500.mt-1= t("catalog_ui.marking_intro", **terms)
  .flex.flex-wrap.gap-2
    - if @lesson_filter
      = link_to t("catalog_ui.show_all_lessons", **terms), queue_path, class: secondary_button
    = link_to (admin_report_context? ? "Back to dashboard" : t("layouts.application.my_courses", **terms)), (admin_report_context? ? admin_root_path : courses_path(mine: 1)), class: secondary_button

- if @manual_lessons.empty? && @ai_lessons.empty?
  .bg-white.border.border-gray-200.rounded.p-4.text-sm.text-gray-500
    = t("catalog_ui.no_marking", **terms)
- else
  - if @manual_lessons.size > 1
    %nav.flex.flex-wrap.gap-2.mb-6{ "aria-label": terms[:lessons] }
      - @manual_lessons.each do |lesson|
        = link_to "#marking-lesson-#{lesson.id}", class: "inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-xs font-medium text-amber-800 hover:bg-amber-100" do
          %span= lesson.title
          %span.rounded-full.bg-amber-600.px-1.5.text-white= lesson.pending_free_text_answers_count

  - @manual_lessons.each do |lesson|
    - answers = @pending_answers.fetch(lesson.id, [])
    %section.mb-10.scroll-mt-20{ id: "marking-lesson-#{lesson.id}" }
      .flex.flex-wrap.items-end.justify-between.gap-3.mb-4.border-b.border-gray-200.pb-3
        %div
          = link_to lesson.course.title, learning_course_report_path(lesson.course), class: "text-sm font-medium text-indigo-700 hover:underline"
          %h2.text-xl.font-semibold.text-gray-900= lesson.title
        .flex.flex-wrap.items-center.gap-3.text-sm
          %span.inline-flex.items-center.rounded-full.border.border-amber-300.bg-amber-100.px-2.5.py-0.5.text-xs.font-semibold.text-amber-900
            = t("catalog_ui.marking_alert", count: lesson.pending_free_text_answers_count)
          %span.text-gray-700= t("catalog_ui.pass_level", level: lesson.free_text_pass_level)
          = link_to t("catalog_ui.full_report"), learning_lesson_report_path(lesson.course, lesson), class: "font-medium text-indigo-700 hover:underline"

      - answers.group_by(&:question_id).each_value do |question_answers|
        = render "marking/question", question: question_answers.first.question, answers: question_answers, lesson: lesson

      - if lesson.pending_free_text_answers_count > answers.size
        %p.text-sm.text-gray-700= t("catalog_ui.showing_oldest", shown: answers.size, total: lesson.pending_free_text_answers_count)

  - if @ai_lessons.any?
    %section.mt-10
      %h2.text-lg.font-semibold.text-gray-900= t("catalog_ui.ai_queue_heading")
      %p.text-sm.text-gray-500.mb-3= t("catalog_ui.ai_queue_hint")
      .bg-white.border.border-gray-200.rounded.overflow-hidden
        %table.w-full.text-sm
          %thead.bg-gray-50
            %tr
              %th.text-left.text-xs.font-medium.text-gray-500.px-3.py-2= terms[:course]
              %th.text-left.text-xs.font-medium.text-gray-500.px-3.py-2= terms[:lesson]
              %th.text-left.text-xs.font-medium.text-gray-500.px-3.py-2 Marking status
              %th.text-right.text-xs.font-medium.text-gray-500.px-3.py-2 Learners
              %th.text-right.text-xs.font-medium.text-gray-500.px-3.py-2 Answers
              %th.text-left.text-xs.font-medium.text-gray-500.px-3.py-2 Latest submission
              %th.text-right.text-xs.font-medium.text-gray-500.px-3.py-2
          %tbody
            - @ai_lessons.each do |lesson|
              %tr.border-t.border-gray-100
                %td.px-3.py-2.text-gray-700= link_to lesson.course.title, learning_course_report_path(lesson.course), class: "text-indigo-600 hover:underline"
                %td.px-3.py-2.font-medium.text-gray-900= lesson.title
                %td.px-3.py-2= render "marking/ai_queued_badge"
                %td.px-3.py-2.text-right.text-gray-700= lesson.pending_learners_count
                %td.px-3.py-2.text-right.text-gray-700= lesson.pending_free_text_answers_count
                %td.px-3.py-2.text-gray-500= lesson.latest_pending_answer_at&.in_time_zone&.strftime("%Y-%m-%d %H:%M %Z (%:z)") || "—"
                %td.px-3.py-2.text-right
                  = link_to "Open report", learning_lesson_report_path(lesson.course, lesson), class: "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-50 text-indigo-700 hover:bg-indigo-100 border border-indigo-100 transition-colors"
