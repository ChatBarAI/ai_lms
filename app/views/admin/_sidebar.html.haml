-# Admin navigation. A fixed left column from 1024px (pure CSS, see application.css);
-# below that it is a modal drawer driven by admin_sidebar_controller.js.
- marking = pending_marking_summary
.admin-sidebar-overlay.fixed.inset-0.z-50.invisible.pointer-events-none{ id: "admin-sidebar", "aria-label": "Admin navigation", data: { admin_sidebar_target: "overlay" } }
  .admin-sidebar-backdrop.absolute.inset-0.opacity-0.transition-opacity.duration-300{ class: "bg-gray-900/50", data: { action: "click->admin-sidebar#close", admin_sidebar_target: "backdrop" } }
  %aside.admin-sidebar-panel.absolute.inset-y-0.left-0.flex.w-full.-translate-x-full.flex-col.shadow-2xl.transition-transform.duration-300{ class: "max-w-[17rem] bg-[var(--admin-nav-bg)] text-[var(--admin-nav-fg)]", tabindex: "-1", data: { admin_sidebar_target: "panel" } }
    .flex.items-start.justify-between.gap-3.px-4.pt-4.pb-2
      = link_to admin_root_path, class: "flex min-w-0 flex-col gap-1.5 [&_img]:max-w-full [&_img]:object-contain [&_img]:object-left" do
        = site_logo_tag
        %span.text-sm.font-semibold.leading-tight= show_site_brand_name? ? "#{site_brand_name} · Admin" : "Admin"
      %button.lg:hidden.inline-flex.h-8.w-8.shrink-0.items-center.justify-center.rounded-md.cursor-pointer{ class: "hover:bg-current/10", type: "button", "aria-label": "Close admin menu", data: { action: "admin-sidebar#close", admin_sidebar_target: "closeButton" } }
        = admin_nav_icon(:close)

    %nav.flex-1.overflow-y-auto.px-3.pb-4{ "aria-label": "Admin" }
      - admin_nav_sections.each do |section|
        .mt-4
          - if section[:heading]
            %p.px-3.pb-1.text-xs.font-semibold.uppercase.tracking-wide.opacity-60= section[:heading]
          %ul.space-y-0.5
            - section[:items].each do |item|
              - active = admin_nav_active?(item)
              %li
                = link_to item[:path], class: "flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors #{active ? 'bg-current/15 font-semibold' : 'opacity-80 hover:opacity-100 hover:bg-current/10'}", "aria-current": (active ? "page" : nil) do
                  = admin_nav_icon(item[:icon])
                  %span.min-w-0.flex-1.truncate= item[:label]
                  - if item[:badge] == :marking && marking
                    %span.rounded-full.bg-amber-500.px-1.5.text-xs.font-semibold.text-white{ title: t("catalog_ui.marking_alert", count: marking[:answers]), data: { nav_badge: true } }= number_with_delimiter(marking[:answers])

    .border-t.px-3.py-3{ class: "border-current/15" }
      = link_to root_path, class: "flex items-center gap-3 rounded-md px-3 py-2 text-sm opacity-80 transition-colors hover:opacity-100 hover:bg-current/10" do
        = admin_nav_icon(:back)
        %span Back to site
      .flex.items-center.gap-2.pl-3.pt-1
        %span.min-w-0.flex-1.truncate.text-xs.opacity-70{ title: current_user.email }= current_user.email
        = button_to destroy_user_session_path, method: :delete, form_class: "shrink-0", class: "inline-flex h-8 w-8 items-center justify-center rounded-md bg-transparent border-0 opacity-80 cursor-pointer hover:opacity-100 hover:bg-current/10", title: "Sign out", "aria-label": "Sign out" do
          = admin_nav_icon(:sign_out, size_class: "h-4 w-4")
