%section{ id: "integration", class: "scroll-mt-24", data: { site_settings_section: "integration" } }
  = form_with model: @site_setting, url: admin_site_setting_path, method: :patch, data: { turbo: false }, class: "rounded-xl border border-gray-200 bg-white p-6 shadow-sm" do |f|
    = hidden_field_tag :section, "integration"

    %h2.text-lg.font-semibold.text-gray-900 Integration and jobs
    %p.text-sm.text-gray-500 App callback URL, email delivery, Redis connection, and queue visibility.

    = render "section_errors", section: "integration"

    .mt-5
      = f.label :app_url, "App URL", class: "block text-sm font-medium mb-1"
      = f.url_field :app_url, placeholder: "https://yourapp.example.com", class: "w-full border border-gray-300 rounded px-3 py-2"
      %p.text-xs.text-gray-500.mt-1 Base URL used for AI task callbacks.

      - stored = @site_setting.app_url.to_s.chomp("/")
      - current = @current_base_url.to_s.chomp("/")
      - if stored.blank?
        .mt-2.rounded.border.border-amber-300.bg-amber-50.px-3.py-2.text-xs.text-amber-800
          %span.font-semibold App URL not set.
          %span.ml-1 Current request URL is #{current}.
      - elsif stored != current
        .mt-2.rounded.border.border-amber-300.bg-amber-50.px-3.py-2.text-xs.text-amber-800
          %span.font-semibold URL mismatch.
          %span.ml-1 Saved: #{stored}. Current request: #{current}.
      - else
        .mt-2.rounded.border.border-green-300.bg-green-50.px-3.py-2.text-xs.text-green-800
          %span.font-semibold URL matches current request.

    .mt-6.border-t.border-gray-200.pt-5
      %h3.font-semibold.text-gray-900 Email delivery
      %p.mt-1.text-xs.text-gray-500 Password resets and account emails use these settings.

      .mt-4.grid.gap-4.md:grid-cols-2
        %div
          = f.label :mail_delivery_method, "Delivery method", class: "block text-sm font-medium mb-1"
          = f.select :mail_delivery_method,
              options_for_select([["Local sendmail", "sendmail"], ["SMTP provider", "smtp"]], @site_setting.mail_delivery_method.presence || "sendmail"),
              {},
              class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"
        %div
          = f.label :mailer_sender, "Sender email", class: "block text-sm font-medium mb-1"
          = f.email_field :mailer_sender, placeholder: "no-reply@example.com", class: "w-full border border-gray-300 rounded px-3 py-2"

      .mt-5.grid.gap-4.md:grid-cols-2
        %div
          = f.label :sendmail_location, "Sendmail path", class: "block text-sm font-medium mb-1"
          = f.text_field :sendmail_location, placeholder: "/usr/sbin/sendmail", class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"
        %div
          = f.label :sendmail_arguments, "Sendmail arguments", class: "block text-sm font-medium mb-1"
          = f.text_field :sendmail_arguments, placeholder: "-i", class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"

      .mt-5.grid.gap-4.md:grid-cols-2
        %div
          = f.label :smtp_address, "SMTP host", class: "block text-sm font-medium mb-1"
          = f.text_field :smtp_address, placeholder: "smtp.example.com", class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"
        %div
          = f.label :smtp_port, "SMTP port", class: "block text-sm font-medium mb-1"
          = f.number_field :smtp_port, min: 1, max: 65535, placeholder: "587", class: "w-full border border-gray-300 rounded px-3 py-2"
        %div
          = f.label :smtp_domain, "SMTP domain", class: "block text-sm font-medium mb-1"
          = f.text_field :smtp_domain, placeholder: "example.com", class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"
        %div
          = f.label :smtp_authentication, "Authentication", class: "block text-sm font-medium mb-1"
          = f.select :smtp_authentication,
              options_for_select([["Provider default", ""], ["Plain", "plain"], ["Login", "login"], ["CRAM-MD5", "cram_md5"]], @site_setting.smtp_authentication),
              {},
              class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"
        %div
          = f.label :smtp_username, "SMTP username", class: "block text-sm font-medium mb-1"
          = f.text_field :smtp_username, autocomplete: "off", class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"
        %div
          = f.label :smtp_password, "SMTP password", class: "block text-sm font-medium mb-1"
          = f.password_field :smtp_password, autocomplete: "new-password", placeholder: (@site_setting.smtp_password.present? ? "Saved; leave blank to keep" : nil), class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"
        %div
          = f.label :smtp_openssl_verify_mode, "TLS verification", class: "block text-sm font-medium mb-1"
          = f.select :smtp_openssl_verify_mode,
              options_for_select([["Provider default", ""], ["Verify peer", "peer"], ["Do not verify", "none"]], @site_setting.smtp_openssl_verify_mode),
              {},
              class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"
        .flex.items-center.pt-6
          - starttls_checked = @site_setting.smtp_enable_starttls_auto.nil? ? true : @site_setting.smtp_enable_starttls_auto
          = f.check_box :smtp_enable_starttls_auto, { checked: starttls_checked, class: "h-4 w-4 rounded border-gray-300 text-indigo-600" }, "1", "0"
          = f.label :smtp_enable_starttls_auto, "Enable STARTTLS automatically", class: "ml-2 text-sm text-gray-700"

    .mt-5
      = f.label :redis_url, "Redis URL", class: "block text-sm font-medium mb-1"
      = f.text_field :redis_url, placeholder: "redis://localhost:6379/0", class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"
      %p.text-xs.text-gray-500.mt-1
        Include the DB number in the URL path (for example, redis://localhost:6379/2).

    .mt-4
      - if @redis_info[:error]
        .rounded.border.border-red-300.bg-red-50.px-4.py-3.text-sm.text-red-800
          %span.font-semibold Could not connect to Redis:
          = @redis_info[:error]
          %br
          %span.text-xs Configured URL:
          %code.text-xs= @redis_info[:url]
      - else
        .rounded.border.border-gray-200.bg-gray-50.px-4.py-3.text-sm.space-y-2
          .flex.flex-wrap.items-center.gap-2
            %span.font-medium.text-gray-700 REDIS_URL:
            %code.bg-white.border.border-gray-200.rounded.px-2.py-0.5.text-xs= @redis_info[:url]
          .flex.flex-wrap.items-center.gap-2
            %span.font-medium.text-gray-700 Current DB:
            %span.inline-flex.items-center.rounded-full.bg-indigo-100.px-2.5.py-0.5.text-xs.font-semibold.text-indigo-800= @redis_info[:current_db]
          .flex.flex-wrap.items-start.gap-2
            %span.font-medium.text-gray-700 DB occupancy:
            .flex.flex-wrap.gap-1
              - (0..15).each do |db|
                - in_use = @redis_info[:used_dbs].include?(db)
                - is_current = db == @redis_info[:current_db]
                - badge_class = is_current ? "bg-indigo-600 text-white" : in_use ? "bg-amber-100 text-amber-800 border border-amber-300" : "bg-green-100 text-green-800 border border-green-300"
                %span.inline-flex.items-center.rounded.px-2.py-0.5.text-xs.font-mono{ class: badge_class }
                  = db
                  - if is_current
                    %span.ml-1 ★
                  - elsif in_use
                    %span.ml-1 (in use)

    .mt-5.border-t.border-gray-200.pt-5
      .flex.flex-col.gap-3.md:flex-row.md:items-start.md:justify-between
        %div
          %h3.font-semibold.text-gray-900 Sidekiq worker
          %p.mt-1.text-xs.text-gray-500
            Redis:
            %span.font-mono= @sidekiq_status.redis_url
        - if @sidekiq_status.available && @sidekiq_status.default_queue_running?
          %span.inline-flex.w-fit.items-center.rounded-full.border.border-green-200.bg-green-50.px-2.5.py-1.text-xs.font-medium.text-green-700 Running
        - elsif @sidekiq_status.available && @sidekiq_status.running?
          %span.inline-flex.w-fit.items-center.rounded-full.border.border-amber-200.bg-amber-50.px-2.5.py-1.text-xs.font-medium.text-amber-700 Worker not on default queue
        - elsif @sidekiq_status.available
          %span.inline-flex.w-fit.items-center.rounded-full.border.border-red-200.bg-red-50.px-2.5.py-1.text-xs.font-medium.text-red-700 No worker heartbeat
        - else
          %span.inline-flex.w-fit.items-center.rounded-full.border.border-red-200.bg-red-50.px-2.5.py-1.text-xs.font-medium.text-red-700 Redis unavailable

      - if @sidekiq_status.available
        .mt-4.grid.grid-cols-2.gap-x-4.gap-y-3.border-y.border-gray-100.py-3.text-sm.md:grid-cols-5
          %div
            .text-xs.uppercase.tracking-wide.text-gray-500 Processes
            .mt-1.text-xl.font-semibold= @sidekiq_status.processes.size
          %div
            .text-xs.uppercase.tracking-wide.text-gray-500 Default queue
            .mt-1.text-xl.font-semibold= @sidekiq_status.default_queue_size
          %div
            .text-xs.uppercase.tracking-wide.text-gray-500 Scheduled
            .mt-1.text-xl.font-semibold= @sidekiq_status.scheduled_size
          %div
            .text-xs.uppercase.tracking-wide.text-gray-500 Retries
            .mt-1.text-xl.font-semibold= @sidekiq_status.retry_size
          %div
            .text-xs.uppercase.tracking-wide.text-gray-500 Dead
            .mt-1.text-xl.font-semibold= @sidekiq_status.dead_size

        - if @sidekiq_status.processes.any?
          .mt-4.overflow-x-auto
            %table.min-w-full.text-sm
              %thead
                %tr.border-b.border-gray-100.text-left.text-xs.uppercase.tracking-wide.text-gray-500
                  %th.py-2.pr-3 Host
                  %th.py-2.pr-3 Tag
                  %th.py-2.pr-3 Queues
                  %th.py-2.pr-3 Busy
                  %th.py-2.pr-3 Started
              %tbody.divide-y.divide-gray-100
                - @sidekiq_status.processes.each do |process|
                  %tr
                    %td.py-2.pr-3.font-mono.text-xs= process[:hostname].presence || process[:identity]
                    %td.py-2.pr-3= process[:tag].presence || "default"
                    %td.py-2.pr-3= process[:queues].presence&.join(", ") || "?"
                    %td.py-2.pr-3= "#{process[:busy]}/#{process[:concurrency]}"
                    %td.py-2.pr-3= process[:started_at]&.strftime("%Y-%m-%d %H:%M") || "?"
        - else
          %p.mt-3.text-sm.text-gray-500 No Sidekiq process has heartbeated in this instance's configured Redis DB.
      - else
        %p.mt-3.text-sm.text-red-700= @sidekiq_status.error

    .mt-6.flex.items-center.gap-2.border-t.border-gray-200.pt-4
      = f.submit "Save integration", class: "px-4 py-2 rounded bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer"
