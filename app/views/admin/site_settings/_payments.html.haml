%section{ id: "payments", class: "scroll-mt-24", data: { site_settings_section: "payments" } }
  = form_with model: @site_setting, url: admin_site_setting_path, method: :patch, data: { turbo: false }, class: "rounded-xl border border-gray-200 bg-white p-6 shadow-sm" do |f|
    = hidden_field_tag :section, "payments"

    .flex.flex-wrap.items-start.justify-between.gap-4
      %div
        %h2.text-lg.font-semibold.text-gray-900= t("payments.title")
        %p.text-sm.text-gray-500= t("payments.settings_description")
      .ml-auto.flex.flex-col.items-end.gap-2
        = link_to t("payments.manage"), admin_payments_path, class: "inline-flex items-center rounded border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50"
        - stripe_key = Payments::Configuration.secret("secret_key")
        - stripe_mode = stripe_key.blank? ? "unconfigured" : (stripe_key.start_with?("sk_live_", "rk_live_") ? "live" : "test")
        %span.text-sm.font-medium.text-gray-500{ title: t("payments.mode_#{stripe_mode}_tooltip"), tabindex: "0", "aria-label": "#{t("payments.mode_#{stripe_mode}")}. #{t("payments.mode_#{stripe_mode}_tooltip")}" }
          = t("payments.mode_#{stripe_mode}")

    = render "section_errors", section: "payments"

    .mt-5.grid.grid-cols-1.gap-6.lg:grid-cols-2
      .min-w-0.space-y-5
        %div
          = toggle_switch_field f, :payments_enabled, label: t("payments.enable")
          %p.text-xs.text-gray-500.mt-1= t("payments.disable_help")

        %div
          = f.label :payment_currency, t("payments.payment_currency"), class: "block text-sm font-medium mb-1"
          = f.select :payment_currency, Payments::Currency::RULES.keys, {}, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"
          %p.text-xs.text-gray-500.mt-1= t("payments.currency_help")

        %div
          = f.label :payment_tax_mode, t("payments.payment_tax_mode"), title: t("payments.payment_tax_mode_tooltip"), class: "block text-sm font-medium mb-1"
          = f.select :payment_tax_mode, %w[unconfigured automatic exempt], {}, title: t("payments.payment_tax_mode_tooltip"), class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"
          %p.text-xs.text-gray-500.mt-1= t("payments.tax_help")

        %div
          = f.label :payment_tax_behavior, t("payments.payment_tax_behavior"), class: "block text-sm font-medium mb-1"
          = f.select :payment_tax_behavior, %w[inclusive exclusive], {}, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"

      .min-w-0.space-y-5
        %div
          = f.label :payment_seller_name, t("payments.payment_seller_name"), class: "block text-sm font-medium mb-1"
          = f.text_field :payment_seller_name, class: "w-full border border-gray-300 rounded px-3 py-2"

        %div
          = f.label :payment_terms_url, t("payments.payment_terms_url"), class: "block text-sm font-medium mb-1"
          = f.url_field :payment_terms_url, class: "w-full border border-gray-300 rounded px-3 py-2"

        %div
          = f.label :payment_support_email, t("payments.payment_support_email"), class: "block text-sm font-medium mb-1"
          = f.email_field :payment_support_email, class: "w-full border border-gray-300 rounded px-3 py-2"

        = toggle_switch_field f, :payment_live_ready, label: t("payments.live_ready")

    .mt-6.border-t.border-gray-200.pt-5
      %h3.font-semibold.text-gray-900{ title: t("payments.credentials_help"), tabindex: "0" }= t("payments.connection_heading")
      .mt-4.grid.grid-cols-1.gap-5.lg:grid-cols-2
        - %w[stripe_secret_key stripe_webhook_secret].each do |field|
          %div
            = f.label field, t("payments.#{field}"), class: "block text-sm font-medium mb-1"
            = f.password_field field, value: "", autocomplete: "new-password", spellcheck: false, placeholder: t("payments.credential_placeholder"), class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm"
      %p.mt-2.text-xs.text-gray-500= t("payments.webhook_check_help")
      .mt-4.grid.grid-cols-1.gap-6.lg:grid-cols-2
        .min-w-0
          .space-y-2.text-xs.text-gray-500
            %p.break-all
              %span.font-medium Webhook:
              %code= stripe_webhook_url
            %p
              %span.font-medium API:
              %code= Payments::StripeClient::API_VERSION

        .min-w-0
          - problems = Payments::Configuration.problems
          -# The account ID is discovered by saving the secret key; a missing key already covers it.
          - problems -= ["STRIPE_ACCOUNT_ID"] if problems.include?("STRIPE_SECRET_KEY")
          - problems = problems.map { |problem| problem == "STRIPE_ACCOUNT_ID" ? t("payments.readiness_account_not_linked") : problem }
          - if problems.any?
            .rounded.border.border-amber-300.bg-amber-50.px-4.py-3.text-sm.text-amber-800
              %p.font-semibold= t("payments.readiness_heading")
              %ul.mt-2.list-disc.pl-5.space-y-1
                - problems.each do |problem|
                  %li= problem

    .mt-6.border-t.border-gray-200.pt-5
      %h3.font-semibold.text-gray-900= t("payments.health_heading")
      .mt-4.grid.grid-cols-1.gap-x-6.gap-y-3.text-sm.text-gray-600.lg:grid-cols-2
        %p= t("payments.worker_status", status: @sidekiq_status.default_queue_running? ? t("payments.configured") : t("payments.missing"))
        %p= t("payments.recovery_at", time: @site_setting.payment_recovery_at || "—")
        %p= t("payments.last_event", time: PaymentEvent.maximum(:processed_at) || "—")
        %p= t("payments.oldest_event", time: PaymentEvent.unfinished.minimum(:created_at) || "—")
        %p= t("payments.exceptions", count: Purchase.attention.count)

    .mt-6.flex.items-center.gap-2.border-t.border-gray-200.pt-4
      = f.submit t("payments.save"), class: "px-4 py-2 rounded bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer"
