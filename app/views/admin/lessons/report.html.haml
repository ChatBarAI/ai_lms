- content_for :title, "#{@lesson.title} – Report"
- content_for :head do
  -# Scoring redirects back here; morph + preserve scroll keeps the marker's place.
  = turbo_refreshes_with method: :morph, scroll: :preserve

.flex.flex-wrap.items-start.justify-between.gap-3.mb-6
  %div
    %h1.text-2xl.font-bold.text-gray-900= @lesson.title
    .mt-1.text-sm.text-gray-700
      = t("catalog_ui.lesson_report", **terms)
      = link_to @course.title, (admin_report_context? ? admin_course_path(@course) : course_path(@course)), class: "font-medium text-indigo-700 hover:underline"
  = link_to t("catalog_ui.back_to_course_report", **terms), learning_course_report_path(@course), class: "px-3 py-1.5 rounded bg-gray-100 text-gray-800 hover:bg-gray-200 border border-gray-300 text-sm font-medium"

- pending = @pending_marking
- if pending.positive? && @lesson.manual_marking?
  = render "shared/marking_alert", summary: { answers: pending }, path: learning_marking_queue_path(lesson: @lesson.id)

.grid.grid-cols-2.md:grid-cols-5.gap-3.mb-6
  - tiles = [ [ "Attempts", @attempts ], [ "Completions", @completions ], [ "Avg score", @average_score&.round(1) || "—" ], [ "Pass rate", @pass_rate ? "#{@pass_rate}%" : "—" ], [ "Avg rating", @average_rating&.round(2) || "—" ] ]
  - tiles.each do |label, value|
    %div{ class: "#{report_card_class} px-4 py-3" }
      .text-xs.font-semibold.uppercase.tracking-wide.text-gray-600= label
      .mt-1.text-2xl.font-semibold.text-gray-900= value

.grid.grid-cols-1.lg:grid-cols-2.lg:items-start.gap-4.mb-6
  %div{ class: report_card_class }
    %h2{ class: report_card_heading_class } Completions per week (12w)
    .p-4= svg_chart @completions_per_week, type: :column, color: "#16a34a"
  %div{ class: report_card_class }
    %h2{ class: report_card_heading_class } Ratings distribution
    - if @ratings_distribution.any?
      .p-4= svg_chart @ratings_distribution.sort.to_h, type: :column, color: "#f59e0b"
    - else
      %div{ class: report_empty_class } No ratings yet.

.grid.grid-cols-1.lg:grid-cols-2.lg:items-start.gap-4
  %div{ class: "#{report_card_class} min-w-0 overflow-hidden" }
    %h2{ class: report_card_heading_class } Recent attempts
    - if @recent_attempts.any?
      .overflow-x-auto
        %table.w-full.table-fixed.text-sm{ class: "min-w-[28rem]" }
          %thead.bg-gray-50
            %tr
              %th.text-left{ class: "#{report_th_class} w-[34%]" } User
              %th.text-left{ class: "#{report_th_class} w-[22%]" } Status
              %th.text-right{ class: "#{report_th_class} w-[14%]" } Score
              %th.text-left{ class: "#{report_th_class} w-[30%]" } Updated
          %tbody.divide-y.divide-gray-200
            - @recent_attempts.each do |p|
              %tr
                %td.px-4.py-2.text-gray-900.break-all= learning_report_user(p.enrollment.user)
                %td.px-4.py-2.text-gray-800= p.status.humanize
                %td.px-4.py-2.text-right.font-medium.text-gray-900= p.score || "—"
                %td.px-4.py-2.text-gray-600= p.updated_at.in_time_zone.strftime("%Y-%m-%d %H:%M %Z (%:z)")
    - else
      %div{ class: report_empty_class } No attempts yet.

  %div{ class: report_card_class }
    %h2{ class: report_card_heading_class } Recent comments
    - if @recent_comments.any?
      %ul.divide-y.divide-gray-200
        - @recent_comments.each do |r|
          %li.px-5.py-3.text-sm
            .flex.justify-between.gap-2
              %span.font-semibold.text-gray-900= r.user.email
              %span.font-semibold.text-amber-700 #{r.stars}★
            .mt-1.text-gray-800= r.comment
    - else
      %div{ class: report_empty_class } No comments yet.

- if @free_text_summary.any?
  %section#marking.mt-8.scroll-mt-20
    .flex.flex-wrap.items-end.justify-between.gap-3.mb-4.border-b.border-gray-200.pb-3
      %h2.text-xl.font-semibold.text-gray-900= t("catalog_ui.lesson_marking", **terms)
      .flex.flex-wrap.items-center.gap-3.text-sm
        - if pending.positive?
          %span.inline-flex.items-center.rounded-full.border.border-amber-300.bg-amber-100.px-2.5.py-0.5.text-xs.font-semibold.text-amber-900= "#{pending} pending"
        %span.text-gray-700= t("catalog_ui.pass_level", level: @lesson.free_text_pass_level)
    %div{ class: "#{report_card_class} overflow-x-auto" }
      %table.w-full.text-sm
        %thead.bg-gray-50
          %tr
            %th.text-left{ class: report_th_class } Question
            %th.text-right{ class: report_th_class } Answers
            %th.text-right{ class: report_th_class } Avg score
            %th.text-right{ class: report_th_class } Pass rate
            %th.text-right{ class: report_th_class } Pending
            %th{ class: report_th_class }
        %tbody.divide-y.divide-gray-200
          - @free_text_summary.each do |row|
            - question_path = learning_question_report_path(@course, @lesson, row[:question])
            %tr.hover:bg-gray-50
              %td.px-4.py-3.font-medium.text-gray-900
                = link_to row[:question].prompt.truncate(140), question_path, class: "hover:text-indigo-700 hover:underline"
              %td.px-4.py-3.text-right.text-gray-900= number_with_delimiter(row[:total])
              %td.px-4.py-3.text-right.text-gray-900= row[:average] ? "#{row[:average]}/10" : "—"
              %td.px-4.py-3.text-right
                - if row[:pass_rate]
                  %span.font-semibold{ class: row[:pass_rate] >= 50 ? "text-green-800" : "text-red-700" }= "#{row[:pass_rate]}%"
                - else
                  %span.text-gray-600 —
              %td.px-4.py-3.text-right
                - if row[:pending].positive?
                  %span.inline-flex.rounded-full.border.border-amber-300.bg-amber-100.px-2.py-0.5.text-xs.font-semibold.text-amber-900= number_with_delimiter(row[:pending])
                - else
                  %span.text-gray-600 0
              %td.px-4.py-3.text-right.whitespace-nowrap
                = link_to t("catalog_ui.view_answers"), question_path, class: "font-medium text-indigo-700 hover:underline"
