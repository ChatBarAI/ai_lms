- content_for :title, "#{@course.title} – Report"

.flex.flex-wrap.items-start.justify-between.gap-3.mb-6
  %div
    %h1.text-2xl.font-bold.text-gray-900= @course.title
    .mt-1.text-sm.text-gray-700= t("catalog_ui.course_report", **terms)
  = link_to t("catalog_ui.back_to_course_without_arrow", **terms), (admin_report_context? ? edit_admin_course_path(@course) : course_path(@course)), class: "px-3 py-1.5 rounded bg-gray-100 text-gray-800 hover:bg-gray-200 border border-gray-300 text-sm font-medium"

-# Only lessons marked by hand need action; AI-queued answers are shown in the table but not in the alert.
- manual_pending = @lesson_summary.map { |row| row[:lesson] }.select(&:manual_marking?).map { |l| @pending_by_lesson.fetch(l.id, 0) }.select(&:positive?)
- if manual_pending.any?
  = render "shared/marking_alert", summary: { answers: manual_pending.sum, lessons: manual_pending.size }, path: learning_marking_queue_path

.grid.grid-cols-2.md:grid-cols-5.gap-3.mb-6
  - tiles = [ [ "Enrolments", @enrollment_count ], [ "Active learners", @active_learners ], [ "Completion rate", "#{@completion_rate}%" ], [ "Avg score", @average_score&.round(1) || "—" ], [ "Avg rating", @average_rating&.round(2) || "—" ] ]
  - tiles.each do |label, value|
    %div{ class: "#{report_card_class} px-4 py-3" }
      .text-xs.font-semibold.uppercase.tracking-wide.text-gray-600= label
      .mt-1.text-2xl.font-semibold.text-gray-900= value

.grid.grid-cols-1.lg:grid-cols-2.lg:items-start.gap-4.mb-6
  %div{ class: report_card_class }
    %h2{ class: report_card_heading_class } Enrolments per week (12w)
    .p-4= svg_chart @enrollments_per_week, type: :column, color: "#0ea5e9"
  %div{ class: report_card_class }
    %h2{ class: report_card_heading_class } Completions per week (12w)
    .p-4= svg_chart @completions_per_week, type: :column, color: "#16a34a"
  %div{ class: "#{report_card_class} lg:col-span-2" }
    %h2{ class: report_card_heading_class } Score distribution
    - if @score_distribution.any?
      .p-4= svg_chart @score_distribution, type: :column, color: "#6366f1"
    - else
      %div{ class: report_empty_class } No scored attempts yet.

%div{ class: "#{report_card_class} overflow-x-auto mb-6" }
  %h2{ class: report_card_heading_class }= t("catalog_ui.per_lesson_summary", **terms)
  %table.w-full.text-sm
    %thead.bg-gray-50
      %tr
        %th.text-left{ class: report_th_class }= terms[:lesson]
        %th.text-right{ class: report_th_class } Attempts
        %th.text-right{ class: report_th_class } Completions
        %th.text-right{ class: report_th_class } Avg score
        %th.text-right{ class: report_th_class } Pass rate
        %th.text-right{ class: report_th_class } Avg rating
        %th.text-right{ class: report_th_class } Pending marking
        %th{ class: report_th_class }
    %tbody.divide-y.divide-gray-200
      - @lesson_summary.each do |row|
        - lesson = row[:lesson]
        - pending = @pending_by_lesson.fetch(lesson.id, 0)
        %tr.hover:bg-gray-50
          %td.px-4.py-3.font-medium.text-gray-900= link_to lesson.title, learning_lesson_report_path(@course, lesson), class: "hover:text-indigo-700 hover:underline"
          %td.px-4.py-3.text-right.text-gray-900= row[:attempts]
          %td.px-4.py-3.text-right.text-gray-900= row[:completions]
          %td.px-4.py-3.text-right.text-gray-900= row[:average_score]&.round(1) || "—"
          %td.px-4.py-3.text-right.text-gray-900= row[:pass_rate] ? "#{row[:pass_rate]}%" : "—"
          %td.px-4.py-3.text-right.text-gray-900= row[:average_rating]&.round(2) || "—"
          %td.px-4.py-3.text-right
            - if pending.positive? && lesson.manual_marking?
              = link_to number_with_delimiter(pending), learning_marking_queue_path(lesson: lesson.id), title: t("catalog_ui.marking_alert", count: pending), class: "inline-flex rounded-full border border-amber-300 bg-amber-100 px-2 py-0.5 text-xs font-semibold text-amber-900 hover:bg-amber-200"
            - elsif pending.positive?
              %span.inline-flex.rounded-full.border.border-indigo-300.bg-indigo-50.px-2.py-0.5.text-xs.font-semibold.text-indigo-800{ title: t("catalog_ui.ai_queue_heading") }= "#{number_with_delimiter(pending)} AI"
            - else
              %span.text-gray-600 0
          %td.px-4.py-3.text-right.whitespace-nowrap
            = link_to "Report", learning_lesson_report_path(@course, lesson), class: "font-medium text-indigo-700 hover:underline"

%div{ class: report_card_class }
  %h2{ class: report_card_heading_class } Top learners
  - if @top_learners.any?
    %table.w-full.text-sm
      %thead.bg-gray-50
        %tr
          %th.text-left{ class: report_th_class } User
          %th.text-right{ class: report_th_class } Completed
          %th.text-right{ class: report_th_class } Avg score
          %th.text-left{ class: report_th_class } Last activity
      %tbody.divide-y.divide-gray-200
        - @top_learners.each do |e|
          %tr
            %td.px-4.py-2.text-gray-900= learning_report_user(e.user)
            %td.px-4.py-2.text-right.text-gray-900= e.lessons_completed_count
            %td.px-4.py-2.text-right.text-gray-900= e.average_score&.round(1) || "—"
            %td.px-4.py-2.text-gray-600.whitespace-nowrap= e.last_progress_at&.in_time_zone&.strftime("%Y-%m-%d") || "—"
  - else
    %div{ class: report_empty_class } No enrolments yet.
