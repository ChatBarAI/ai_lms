- content_for :title, t(".title")

%h1.text-2xl.font-bold.mb-6= t(".heading")

.max-w-lg.bg-white.border.border-gray-200.rounded-lg.p-6
  .flex.items-center.gap-5.mb-6
    - if current_user.avatar.attached?
      = image_tag url_for(current_user.avatar), class: "w-20 h-20 rounded-full object-cover border border-gray-200"
    - elsif current_user.image_url.present?
      = image_tag current_user.image_url, class: "w-20 h-20 rounded-full object-cover border border-gray-200"
    - else
      .w-20.h-20.rounded-full.bg-indigo-100.flex.items-center.justify-center.text-indigo-600.text-2xl.font-bold
        = current_user.display_name.first.upcase
    .space-y-0.5
      %p.font-semibold.text-lg= current_user.display_name
      %p.text-sm.text-gray-500= current_user.email
      %p.text-sm.text-gray-500= t(".language", language: current_user.locale_name)
      %p.text-sm.text-gray-500= t(".course_languages", **terms, languages: current_user.course_locale_names.join(", "))
      %span.inline-block.rounded.bg-gray-100.px-2.py-0.5.text-xs.capitalize.text-gray-600= current_user.role

  = link_to t(".edit"), edit_profile_path, class: "inline-block px-4 py-2 rounded bg-indigo-600 text-white text-sm hover:bg-indigo-700"
  = link_to t(".change_password"), edit_user_registration_path, class: "inline-block px-4 py-2 rounded bg-gray-100 text-gray-700 text-sm hover:bg-gray-200"

%section.mt-8{ id: "my-certificates" }
  %h2.text-xl.font-semibold.mb-4= t("learning_completion.my_certificates")
  - if @certificate_courses.empty?
    .rounded-xl.border.border-gray-200.bg-white.p-6
      %p.text-sm.text-gray-600= t("learning_completion.no_certificates", course: terms[:course_l])
  - else
    .space-y-4
      - @certificate_courses.each do |course|
        %article.overflow-hidden.rounded-xl.border.border-gray-200.bg-white.shadow-sm
          .px-5.py-4.sm:px-6
            %h3.text-lg.font-semibold.break-words
              = link_to course.title, course_path(course), class: "rounded hover:text-indigo-600 focus-visible:ring-2 focus-visible:ring-indigo-500"
          = render "learning/certificate_footer", course: course, enrollment: @enrollments_by_course[course.id], show_completion_details: true, summary_id: "profile-completion-#{course.id}"
