- content_for :title, t(".title")

.max-w-4xl
  %h1.text-2xl.font-bold.mb-6= t(".heading")

  %section.overflow-hidden.rounded-xl.border.border-gray-200.bg-white.shadow-sm
    .flex.flex-col.gap-5.px-5.py-5.sm:flex-row.sm:items-center.sm:px-6
      = user_avatar_tag(current_user, size_class: "w-16 h-16 shrink-0", initial_class: "text-xl")
      .min-w-0.flex-1
        .flex.flex-wrap.items-center.gap-2
          %p.text-lg.font-semibold.break-words= current_user.display_name
          %span.inline-block.rounded-full.bg-gray-100.px-2.py-0.5.text-xs.font-medium.capitalize.text-gray-600= current_user.role
        %p.mt-0.5.text-sm.text-gray-500.break-all= current_user.email
      .flex.flex-wrap.gap-3.sm:shrink-0
        = link_to t(".edit"), edit_profile_path, class: "inline-flex items-center justify-center rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-indigo-700 focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2"
        = link_to t(".change_password"), edit_user_registration_path, class: "inline-flex items-center justify-center rounded-lg border border-gray-300 px-4 py-2.5 text-sm font-medium hover:bg-gray-50 focus-visible:ring-2 focus-visible:ring-indigo-500"

    .border-t.border-gray-200.px-5.py-5.sm:px-6
      %h2.text-xs.font-semibold.uppercase.tracking-wide.text-gray-500= t(".preferences")
      %dl.mt-3.grid.gap-x-6.gap-y-3.text-sm{ class: "sm:grid-cols-[12rem_1fr]" }
        %dt.text-gray-500= t(".language")
        %dd.font-medium.text-gray-900= current_user.locale_name
        %dt.text-gray-500= t(".course_languages", **terms)
        %dd.font-medium.text-gray-900= current_user.course_locale_names.join(", ")
        %dt.text-gray-500= t("time_zones.label")
        %dd.font-medium.text-gray-900
          = current_user.effective_time_zone
          - if current_user.time_zone.blank?
            %span.ml-1.font-normal.text-gray-500= "· #{t("time_zones.automatic")}"

  %section.mt-8{ id: "my-certificates" }
    %h2.text-xl.font-semibold.mb-4= t("learning_completion.my_certificates")
    - if @certificate_courses.empty?
      .rounded-xl.border.border-gray-200.bg-white.p-6.shadow-sm
        %p.text-sm.text-gray-600= t("learning_completion.no_certificates", course: terms[:course_l])
    - else
      .space-y-4
        - @certificate_courses.each do |course|
          %article.overflow-hidden.rounded-xl.border.border-gray-200.bg-white.shadow-sm
            .px-5.py-4.sm:px-6
              %h3.text-lg.font-semibold.break-words
                = link_to course.title, course_path(course), class: "rounded hover:text-indigo-600 focus-visible:ring-2 focus-visible:ring-indigo-500"
            = render "learning/certificate_footer", course: course, enrollment: @enrollments_by_course[course.id], show_completion_details: true, summary_id: "profile-completion-#{course.id}"
