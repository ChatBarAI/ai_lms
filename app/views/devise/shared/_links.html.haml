.flex.flex-col.gap-1.text-sm.text-indigo-600
  - site_setting = SiteSetting.current
  - kinde_enabled = Rails.application.credentials.dig(:kinde, :client_id).present?
  - if controller_name != 'sessions'
    = link_to t("devise.views.links.log_in"), new_session_path(resource_name), class: "hover:text-indigo-800"
  - if devise_mapping.registerable? && controller_name != 'registrations' && controller_name != 'sessions' && site_setting.self_service_sign_up_enabled?
    = link_to t("devise.views.links.sign_up"), new_registration_path(resource_name), class: "hover:text-indigo-800"
  - if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations'
    = link_to t("devise.views.links.forgot_password"), new_password_path(resource_name), class: "hover:text-indigo-800"
  - if devise_mapping.confirmable? && controller_name != 'confirmations'
    = link_to t("devise.views.links.confirmation_instructions"), new_confirmation_path(resource_name), class: "hover:text-indigo-800"
  - if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks'
    = link_to t("devise.views.links.unlock_instructions"), new_unlock_path(resource_name), class: "hover:text-indigo-800"
  - if devise_mapping.omniauthable? && !kinde_enabled
    - resource_class.omniauth_providers.each do |provider|
      - next if provider.to_s == "google_oauth2" && !site_setting.kinde_google_sign_in_enabled?
      = button_to t("devise.views.links.sign_in_with", provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "mt-2 inline-flex items-center justify-center px-3 py-1.5 rounded bg-white border border-gray-300 text-gray-700 text-sm hover:bg-gray-50"
  - if kinde_enabled
    - enabled_provider_count = [site_setting.kinde_google_sign_in_enabled?, site_setting.kinde_microsoft_sign_in_enabled?].count(true)
    .mt-3.flex.flex-col.gap-2
      - if site_setting.kinde_google_sign_in_enabled?
        = link_to kinde_login_path(provider: "google"), data: { turbo: false, google_sso_url: kinde_login_path(provider: "google") }, class: "inline-flex items-center gap-2 px-3 py-1.5 rounded bg-white border border-gray-300 text-gray-700 text-sm hover:bg-gray-50" do
          = image_tag "auth/google.svg", width: 18, height: 18, alt: ""
          = t("devise.views.links.continue_with_google")
      - if site_setting.kinde_microsoft_sign_in_enabled?
        = link_to kinde_login_path(provider: "microsoft"), data: { turbo: false }, class: "inline-flex items-center gap-2 px-3 py-1.5 rounded bg-white border border-gray-300 text-gray-700 text-sm hover:bg-gray-50" do
          = image_tag "auth/microsoft.svg", width: 18, height: 18, alt: ""
          = t("devise.views.links.continue_with_microsoft")
      - if enabled_provider_count > 1
        = link_to kinde_login_path, data: { turbo: false }, class: "inline-flex items-center gap-2 px-3 py-1.5 rounded bg-white border border-gray-300 text-gray-700 text-sm hover:bg-gray-50" do
          %svg{xmlns: "http://www.w3.org/2000/svg", fill: "none", viewBox: "0 0 24 24", "stroke-width": "1.5", stroke: "currentColor", width: "18", height: "18", "aria-hidden": "true"}
            %path{"stroke-linecap": "round", "stroke-linejoin": "round", d: "M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"}
          = t("devise.views.links.other_sso")
