-# Password input with a show/hide (eye) toggle.
-# Locals: f (form builder), field (attribute), autocomplete, autofocus (optional)
- show_label = t("devise.views.password_field.show_password")
- hide_label = t("devise.views.password_field.hide_password")
.relative{ data: { controller: "password-visibility",
    password_visibility_show_label_value: show_label,
    password_visibility_hide_label_value: hide_label } }
  = f.password_field field, autocomplete: autocomplete, autofocus: local_assigns.fetch(:autofocus, false),
      data: { password_visibility_target: "input" },
      class: "block w-full rounded border border-gray-300 py-2 pl-3 pr-10 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none"
  %button.absolute.inset-y-0.right-0.flex.items-center.px-3.opacity-60.hover:opacity-100.focus:outline-none.focus-visible:opacity-100.cursor-pointer{ type: "button",
      "aria-label": show_label, "aria-pressed": "false",
      title: show_label,
      data: { password_visibility_target: "button", action: "password-visibility#toggle" } }
    = image_tag "eye.png", alt: "", width: 20, height: 20, class: "w-5 h-5 dark:invert",
        data: { password_visibility_target: "showIcon" }
    = image_tag "eye-slash.png", alt: "", width: 20, height: 20, class: "w-5 h-5 dark:invert hidden",
        data: { password_visibility_target: "hideIcon" }
