- if resource.errors.any?
  - messages = resource.errors.full_messages
  .mb-4.rounded.border.border-red-200.bg-red-50.px-4.py-3.text-sm.text-red-800{ role: "alert" }
    - if messages.one?
      %p= messages.first
    - else
      %p.font-medium= t("errors.messages.not_saved", count: messages.size)
      %ul.list-disc.list-inside.mt-1
        - messages.each do |message|
          %li= message
