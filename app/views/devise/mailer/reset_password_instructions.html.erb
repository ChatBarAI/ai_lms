<h1 style="margin:0 0 20px;font-size:24px;line-height:32px;color:<%= @page_foreground %>;">Reset your password</h1>

<p style="margin:0 0 16px;font-size:16px;line-height:24px;">Hello <%= @recipient_name %>,</p>

<p style="margin:0 0 24px;font-size:16px;line-height:24px;">We received a request to reset the password for your <%= @brand_name %> account.</p>

<table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:0 0 24px;">
  <tr>
    <td style="border-radius:8px;background:<%= @button_background %>;">
      <%= link_to "Reset password", edit_password_url(@resource, reset_password_token: @token), style: "display:inline-block;padding:12px 20px;color:#{@button_foreground};font-size:16px;font-weight:700;text-decoration:none;" %>
    </td>
  </tr>
</table>

<p style="margin:0 0 12px;font-size:14px;line-height:21px;">If you did not request this, you can safely ignore this email.</p>
<p style="margin:0;font-size:14px;line-height:21px;">Your password will not change until you use the link above and choose a new one.</p>
