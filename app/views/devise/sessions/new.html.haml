- site_setting = SiteSetting.current
- kinde_enabled = Rails.application.credentials.dig(:kinde, :client_id).present?
- google_enabled = kinde_enabled && site_setting.kinde_google_sign_in_enabled?
- microsoft_enabled = kinde_enabled && site_setting.kinde_microsoft_sign_in_enabled?
- omniauth_providers = (!kinde_enabled && devise_mapping.omniauthable?) ? resource_class.omniauth_providers.reject { |pr| pr.to_s == "google_oauth2" && !site_setting.kinde_google_sign_in_enabled? } : []
.signup
  %section.signup__form
    %h1.signup__title= t("devise.views.sessions.new.heading")
    %p.signup__lead= t("devise.views.sessions.new.subtitle")

    - if google_enabled || microsoft_enabled || omniauth_providers.any?
      - if google_enabled
        = link_to kinde_login_path(provider: "google"), data: { turbo: false, google_sso_url: kinde_login_path(provider: "google") }, class: "signup__sso" do
          = image_tag "auth/google.svg", width: 18, height: 18, alt: ""
          %span= t("devise.views.sessions.new.google")
      - if microsoft_enabled
        = link_to kinde_login_path(provider: "microsoft"), data: { turbo: false }, class: "signup__sso" do
          = image_tag "auth/microsoft.svg", width: 18, height: 18, alt: ""
          %span= t("devise.views.sessions.new.microsoft")
      - omniauth_providers.each do |provider|
        = button_to t("devise.views.links.sign_in_with", provider: OmniAuth::Utils.camelize(provider)), omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "signup__sso signup__sso--button"
      .signup__divider
        %span= t("devise.views.registrations.new.or")

    = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
      = f.email_field :email, autofocus: true, autocomplete: "email", required: true, placeholder: "#{User.human_attribute_name(:email)} *", "aria-label": User.human_attribute_name(:email), data: { sso_check_url: sso_check_path }, class: "signup__field"
      #sso-redirect-notice.signup__notice.hidden
      = f.password_field :password, autocomplete: "current-password", required: true, placeholder: "#{User.human_attribute_name(:password)} *", "aria-label": User.human_attribute_name(:password), class: "signup__field"
      - if devise_mapping.rememberable?
        .mb-4
          = toggle_switch_field f, :remember_me, label: t("devise.views.sessions.new.remember_me")
      = f.submit t("devise.views.sessions.new.submit"), class: "signup__cta"

    .signup__links
      - if devise_mapping.recoverable?
        %p= link_to t("devise.views.links.forgot_password"), new_password_path(resource_name)

  = render "devise/shared/auth_panel", text: t("devise.views.sessions.new.panel_text", brand: site_brand_name)

:javascript
  (function () {
    const emailField = document.querySelector('[data-sso-check-url]');
    if (!emailField) return;
    const checkUrl = emailField.dataset.ssoCheckUrl;
    const notice = document.getElementById('sso-redirect-notice');
    const googleSsoLink = document.querySelector('[data-google-sso-url]');
    let debounce;

    function updateGoogleLoginHint() {
      if (!googleSsoLink) return;

      const url = new URL(googleSsoLink.dataset.googleSsoUrl, window.location.origin);
      const email = emailField.value.trim();
      if (email.includes('@')) url.searchParams.set('login_hint', email);
      googleSsoLink.href = url.pathname + url.search;
    }

    emailField.addEventListener('input', updateGoogleLoginHint);
    if (googleSsoLink) googleSsoLink.addEventListener('click', updateGoogleLoginHint);
    updateGoogleLoginHint();

    emailField.addEventListener('blur', function () {
      clearTimeout(debounce);
      const email = emailField.value.trim();
      if (!email.includes('@')) return;

      fetch(checkUrl + '?email=' + encodeURIComponent(email), {
        headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' }
      })
      .then(r => r.json())
      .then(data => {
        if (data.sso_url) {
          notice.textContent = #{t("devise.views.sessions.new.sso_redirecting").to_json};
          notice.classList.remove('hidden');
          window.location.href = data.sso_url;
        }
      })
      .catch(() => {}); // silently ignore network errors
    });
  })();
