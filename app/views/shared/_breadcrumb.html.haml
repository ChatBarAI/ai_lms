-# locals: id, links (Array of [label, path]); block supplies the current page
%nav.min-w-0.text-sm.text-gray-600.dark:text-gray-300{ id: id, "aria-label": t("common.breadcrumb") }
  %ol.flex.flex-wrap.items-center.gap-x-2.gap-y-1
    - links.each do |label, path|
      %li.flex.items-center.gap-2
        = link_to label, path, class: "hover:text-indigo-700 hover:underline"
        %svg.h-4.w-4.shrink-0.text-gray-500.dark:text-gray-400{ xmlns: "http://www.w3.org/2000/svg", viewBox: "0 0 20 20", fill: "none", stroke: "currentColor", "stroke-width": "2", "stroke-linecap": "round", "stroke-linejoin": "round", "aria-hidden": "true" }
          %path{ d: "M7.5 4.5 13 10l-5.5 5.5" }
    %li.font-medium.text-gray-900.dark:text-gray-100{ "aria-current": "page" }
      = yield
