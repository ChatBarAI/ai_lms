= link_to subject_path(subject), class: "block h-full bg-white border border-gray-200 rounded-lg p-4 hover:border-indigo-300" do
  %h3.font-semibold= subject.name
  %p.text-sm.text-gray-500.mt-1
    = t("subjects.index.courses_count", count: local_assigns.fetch(:course_count) { subject.courses.count }, **terms)
  - if subject.description.present?
    %p.text-sm.text-gray-600.mt-2.line-clamp-2= subject.description
