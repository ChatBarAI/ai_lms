- content_for :title, "Edit material"

.flex.items-center.justify-between.gap-4.mb-4
  %h1.text-2xl.font-bold= "Edit material · #{@lesson_material.title}"
  .flex.items-center.gap-2.shrink-0
    = link_to "← Back to lesson", edit_course_lesson_path(@course, @lesson), class: "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700 hover:bg-indigo-100 hover:text-indigo-700 transition-colors"
    = link_to "View material", course_lesson_lesson_material_path(@course, @lesson, @lesson_material), target: "_blank", rel: "noopener", class: "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800 hover:bg-indigo-200 transition-colors"
    = link_to "Design", course_lesson_lesson_material_material_design_revisions_path(@course, @lesson, @lesson_material), class: "ai-design-action inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-medium bg-violet-100 text-violet-800 hover:bg-violet-200 transition-colors"
.p-4.bg-white.border.border-gray-200.rounded-lg
  = render "form", course: @course, lesson: @lesson, material: @lesson_material
