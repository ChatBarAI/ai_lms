- content_for :javascript do
  = javascript_import_module_tag "actiontext_editor"

- url = material.persisted? ? course_lesson_lesson_material_path(course, lesson, material) : course_lesson_lesson_materials_path(course, lesson)
- kind_options = [["PDF", "pdf"], ["Rich text (Trix editor)", "html"], ["Raw HTML — inline", "raw_html"], ["Raw HTML — isolated iframe", "raw_html_iframe"], ["Google Docs import", "google_doc"], ["Web page import — URL", "web_page"], ["Audio — upload file", "audio_upload"], ["Audio — external URL", "audio_url"], ["Image — upload file", "image_upload"], ["Video — upload file", "video_upload"], ["Video — external URL", "video_url"]]
- unless material.persisted?
  - kind_options.unshift(["Create from copy", "copy"])
  - kind_options.unshift(["AI-designed page", "ai_designed"])

= form_with model: material, url: url, multipart: true, local: true, data: { turbo: false, controller: "material-kind" }, class: "space-y-4 bg-white mt-3" do |f|
  - if material.errors.any?
    .bg-red-50.border.border-red-200.text-red-800.rounded.p-3.text-sm
      %ul.list-disc.pl-5
        - material.errors.full_messages.each do |msg|
          %li= msg

  %div
    = f.label :title, class: "block text-sm font-medium mb-1"
    = f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2"

  .space-y-4
    .grid.grid-cols-1.sm:grid-cols-3.gap-4
      %div
        = f.label :kind, class: "block text-sm font-medium mb-1"
        = f.select :kind,
          kind_options,
            {},
            class: "w-full border border-gray-300 rounded px-3 py-2 bg-white",
            data: { action: "change->material-kind#toggle" }
      %div
        = f.label :position, class: "block text-sm font-medium mb-1"
        = f.number_field :position, class: "w-full border border-gray-300 rounded px-3 py-2"
      .flex.flex-col.gap-3.pt-1
        %div
          = toggle_switch_field f, :required,
              label: "Required before #{terms[:quiz_l]}"
        %div{ title: "Display this material open by default when the lesson is shown." }
          = toggle_switch_field f, :open_by_default,
              label: "Open by default"

    %div{ data: { material_kind_target: "pdf" }, class: ("hidden" if material.kind != "pdf") }
      = upload_field f, :document,
          label: "PDF file — max 25 MB",
          accept: "application/pdf",
          preview_type: :file,
          current_attachment: material.document

    %div{ data: { controller: "trix-insert-html" } }
      = f.label :body, "Material Description", class: "block text-sm font-medium mb-1"
      = f.rich_text_area :body, class: "resizable-rich-text-editor block w-full border border-gray-300 rounded"
      .flex.justify-end.mt-2
        %button.inline-flex.items-center.px-2.5.py-0.5.rounded-full.text-xs.font-medium.bg-gray-100.text-gray-800.hover:bg-gray-200.border.border-gray-200{ type: "button", data: { action: "trix-insert-html#toggle" } } &lt;&gt; Insert HTML
      .hidden.mt-2.p-3.bg-gray-50.border.border-gray-200.rounded{ data: { trix_insert_html_target: "panel" } }
        %p.text-xs.text-gray-500.mb-2 HTML will be converted to Trix's document model. Some formatting may be lost.
        %textarea.w-full.font-mono.text-sm.border.border-gray-300.rounded.px-2.py-1{ rows: 6, placeholder: "<p>Your HTML here…</p>", data: { trix_insert_html_target: "input" } }
        .flex.gap-2.mt-2
          %button.px-3.py-1.text-sm.rounded.bg-indigo-600.text-white.hover:bg-indigo-700{ type: "button", data: { action: "trix-insert-html#insert" } } Insert
          %button.px-3.py-1.text-sm.rounded.border.border-gray-300.hover:bg-gray-50{ type: "button", data: { action: "trix-insert-html#cancel" } } Cancel

    %div{ data: { material_kind_target: "rawhtml" }, class: ("hidden" unless %w[raw_html raw_html_iframe].include?(material.kind)) }
      = f.label :raw_html_content, "Raw HTML", class: "block text-sm font-medium mb-1"
      = f.text_area :raw_html_content, rows: 16, class: "w-full border border-gray-300 rounded px-3 py-2 font-mono text-sm", placeholder: "<p>Paste or write HTML here…</p>"
      %p.text-xs.text-gray-500.mt-1 Inline mode retains safe element styles but removes stylesheet blocks. Isolated iframe mode also retains sanitised &lt;style&gt; blocks. Scripts, forms, nested iframes, event handlers, CSS URLs, and remote fonts are removed in both modes.

    %div{ data: { material_kind_target: "googledoc" }, class: ("hidden" if material.kind != "google_doc") }
      = f.label :google_doc_zip, "Google Docs Web Page ZIP", class: "block text-sm font-medium mb-1"
      = f.file_field :google_doc_zip, accept: ".zip,application/zip", class: "block w-full border border-gray-300 rounded px-3 py-2 bg-white"
      %p.text-xs.text-gray-500.mt-1
        In Google Docs, choose File → Download → Web Page (.html, zipped), then upload that ZIP here. Maximum 25 MB.
      - if material.persisted? && material.google_doc?
        %p.text-xs.text-amber-700.mt-1 Leave this blank to keep the currently imported document, or choose a new ZIP to replace it.

    %div{ data: { material_kind_target: "webpage" }, class: ("hidden" if material.kind != "web_page") }
      = f.label :url, "Public web page URL", class: "block text-sm font-medium mb-1"
      = f.url_field :url, class: "w-full border border-gray-300 rounded px-3 py-2", placeholder: "https://example.com/page"
      %p.text-xs.text-gray-500.mt-1 The LMS imports a static snapshot of public HTTPS HTML plus same-origin styles and images. Saving an existing web-page material refreshes its snapshot.

    %div{ data: { material_kind_target: "audioupload" }, class: ("hidden" if material.kind != "audio_upload") }
      = upload_field f, :audio_file,
          label: "Audio file — mp3, wav, ogg, aac, m4a, flac — max 50 MB",
          accept: "audio/mpeg,audio/vnd.wave,audio/x-wav,audio/ogg,audio/aac,audio/mp4,audio/x-m4a,audio/webm,audio/flac",
          preview_type: :file,
          current_attachment: material.audio_file

    %div{ data: { material_kind_target: "audiourl" }, class: ("hidden" if material.kind != "audio_url") }
      = f.label :url, "Audio URL", class: "block text-sm font-medium mb-1"
      = f.url_field :url, class: "w-full border border-gray-300 rounded px-3 py-2", placeholder: "https://example.com/audio.mp3"
      %p.text-xs.text-gray-500.mt-1 Direct link to an mp3 or other audio file.

    %div{ data: { material_kind_target: "imageupload" }, class: ("hidden" if material.kind != "image_upload") }
      = upload_field f, :image_file,
          label: "Image file — png, jpeg, webp, gif — max 10 MB",
          accept: "image/png,image/jpeg,image/webp,image/gif",
          preview_type: :image,
          current_attachment: material.image_file

    %div{ data: { material_kind_target: "videoupload" }, class: ("hidden" if material.kind != "video_upload") }
      = upload_field f, :video_file,
          label: "Video file — mp4, webm, ogg — max 100 MB",
          accept: "video/mp4,video/webm,video/ogg",
          preview_type: :file,
          current_attachment: material.video_file

    %div{ data: { material_kind_target: "videourl" }, class: ("hidden" if material.kind != "video_url") }
      = f.label :url, "Video URL", class: "block text-sm font-medium mb-1"
      = f.url_field :url, class: "w-full border border-gray-300 rounded px-3 py-2", placeholder: "https://example.com/video.mp4"
      %p.text-xs.text-gray-500.mt-1 Direct link to an mp4, webm, or ogg video file.

    - unless material.persisted?
      .fixed.inset-0.z-50.hidden{ id: "copy-material-dialog", data: { controller: "dialog", dialog_open_value: "false", material_kind_target: "copy" }, role: "dialog", "aria-modal": "true", "aria-labelledby": "copy-material-dialog-title", "aria-hidden": "true" }
        .absolute.inset-0{ style: "background:rgba(17,24,39,0.5);backdrop-filter:blur(2px)", data: { action: "click->dialog#close" } }
        .absolute.bg-white.rounded-xl.shadow-2xl.border.border-violet-200{ style: "top:50%;left:50%;transform:translate(-50%,-50%);width:min(92vw,36rem);max-height:90vh", tabindex: "-1", data: { dialog_target: "panel" } }
          .flex.items-center.justify-between.border-b.border-gray-200.px-5.py-4
            %div
              %h2.font-semibold.text-gray-900{ id: "copy-material-dialog-title", title: "Choose material from one of your courses." } Create from copy
            %button.text-gray-500.hover:text-gray-700.text-2xl.leading-none.cursor-pointer{ type: "button", data: { action: "click->dialog#close", dialog_target: "closeButton" }, "aria-label": "Close" } ×
          .space-y-4.p-5.overflow-y-auto{ style: "max-height:calc(90vh - 5rem)", data: { controller: "material-copy-selector", material_copy_selector_catalog_value: copy_source_catalog.to_json } }
            %div
              - if copy_source_catalog.any?
                .space-y-4
                  %div
                    = label_tag :source_course_id, "Course", class: "block text-sm font-medium mb-1"
                    = select_tag :source_course_id,
                      options_for_select(copy_source_catalog.map { |entry| [entry[:title], entry[:id]] }),
                      prompt: "Choose a course…",
                      class: "w-full border border-gray-300 rounded px-3 py-2 bg-white",
                      data: { material_copy_selector_target: "course", action: "change->material-copy-selector#courseChanged" }
                  .hidden{ data: { material_copy_selector_target: "lessonGroup" } }
                    = label_tag :source_lesson_id, "Lesson", class: "block text-sm font-medium mb-1"
                    = select_tag :source_lesson_id, "", prompt: "Choose a course first…", disabled: true, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white disabled:bg-gray-100 disabled:text-gray-500", data: { material_copy_selector_target: "lesson", action: "change->material-copy-selector#lessonChanged" }
                  .hidden{ data: { material_copy_selector_target: "materialGroup" } }
                    = label_tag :source_material_id, "Material", class: "block text-sm font-medium mb-1"
                    = select_tag :source_material_id, "", prompt: "Choose a lesson first…", disabled: true, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white disabled:bg-gray-100 disabled:text-gray-500", data: { material_copy_selector_target: "material", action: "change->material-copy-selector#materialChanged" }
                %p.text-xs.text-gray-500.mt-3 The copy receives its own files and can be edited or deleted independently.
              - else
                %p.rounded.border.border-amber-200.bg-amber-50.p-3.text-sm.text-amber-800 There are no materials in your courses to copy yet.
            .space-y-3
              %div
                = check_box_tag :copy_settings, "1", true, id: "copy_settings"
                = label_tag :copy_settings, "Copy required and open-by-default settings", class: "ml-1 text-sm"
              %div
                = check_box_tag :open_in_designer, "1", true, id: "open_in_designer"
                = label_tag :open_in_designer, "Open HTML-compatible copies in the AI designer", class: "ml-1 text-sm"
            .flex.justify-end.gap-2.pt-2
              %button.px-4.py-2.rounded-lg.bg-gray-100.text-gray-700.text-sm.font-medium.hover:bg-gray-200.cursor-pointer{ type: "button", data: { action: "click->dialog#close" } } Cancel
              = submit_tag "Create copy", disabled: true, class: "px-4 py-2 rounded-lg bg-violet-600 text-white text-sm font-medium hover:bg-violet-700 disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer", data: { material_copy_selector_target: "submit" }

  .flex.w-full.gap-2
    = f.submit class: "flex-1 px-4 py-2 rounded bg-indigo-600 text-white hover:bg-indigo-700 cursor-pointer text-center", data: { material_kind_submit: true, default_label: (material.persisted? ? "Update material" : "Create material") }
    = link_to "Cancel", edit_course_lesson_path(course, lesson), class: "px-4 py-2 rounded border border-amber-300 bg-amber-100 text-amber-800 hover:bg-amber-200 text-center"
