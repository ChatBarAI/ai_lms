.grid.grid-cols-1.gap-4
  .flex.flex-col.gap-4.sm:flex-row.sm:items-start
    %div.flex-1.min-w-0
      = f.label :title, class: "block text-sm font-medium mb-1"
      = f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2"

    %div.sm:w-48
      = f.label :locale, class: "block text-sm font-medium mb-1"
      = f.select :locale, User::SUPPORTED_LOCALES.map { |code, label| [label, code] }, {}, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"

  %div
    = f.label :description, class: "block text-sm font-medium mb-1"
    = f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded px-3 py-2"

  .flex.flex-col.gap-4.sm:flex-row.sm:items-end
    - if subjects_enabled?
      %div.flex-1
        = f.label :subject_id, "Subject", class: "block text-sm font-medium mb-1"
        = f.collection_select :subject_id, Subject.order(:name), :id, :name, { include_blank: admin ? "—" : "Select a subject" }, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"

    - if admin
      %div.flex-1
        = f.label :owner_id, "Owner", class: "block text-sm font-medium mb-1"
        = f.collection_select :owner_id, User.course_owners.order(:email), :id, :email, { include_blank: "—" }, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"

    %div.flex-1
      = f.label :published_at, "Publish at", class: "block text-sm font-medium mb-1"
      = hidden_field_tag :form_time_zone, Time.zone.tzinfo.identifier
      = f.datetime_local_field :published_at, title: "Leave blank to keep this #{terms[:course_l]} as a draft.", class: "w-full border border-gray-300 rounded px-3 py-2"
      %p.text-xs.text-gray-500= t("time_zones.input_hint", zone: Time.zone.tzinfo.identifier)

    %div.sm:w-40
      = f.label :learning_order, "Learning order", class: "block text-sm font-medium mb-1"
      = f.number_field :learning_order, min: 0, step: 1, placeholder: "Optional", class: "w-full border border-gray-300 rounded px-3 py-2"

    %div.flex-1.pb-2
      = toggle_switch_field f, :public_access_enabled,
          label: "Allow public access",
          title: "Published #{terms[:courses_l]} with public access can be viewed by people who are not signed in, including their #{terms[:lessons_l]} and uploaded content."

  %div
    = upload_field f, :cover_image,
        label: "Upload cover image (PNG, JPG or WebP, max 5 MB)",
        accept: "image/png,image/jpeg,image/webp",
        current_attachment: course.cover_image,
        remove_name: "course[remove_cover_image]",
        remove_label: "Remove current cover image",
        hint: "Cover image (optional) — recommended 728 × 320 px",
        crop_size: [ 728, 320 ]

  %div
    = render "shared/tag_picker", f: f, record: course

  %section.border-t.border-gray-200.pt-4.space-y-4{ "aria-labelledby": "course-gating-heading" }
    %h3.text-sm.font-semibold.text-gray-900#course-gating-heading= t("catalog_ui.gating_heading")
    %div
      = toggle_switch_field f, :sequential_lessons,
          label: t("catalog_ui.sequential_lessons_label", **terms),
          title: t("catalog_ui.sequential_lessons_hint", **terms)

    - options = Course.prerequisite_options_for(except: course)
    - if options.any?
      %div
        %p.block.text-sm.font-medium.mb-1= t("catalog_ui.prerequisite_heading", **terms)
        %p.text-xs.text-gray-500.mb-2= t("catalog_ui.prerequisite_hint", **terms)
        = hidden_field_tag "course[prerequisite_course_ids][]", ""
        %fieldset
          %legend.sr-only= t("catalog_ui.prerequisite_legend", **terms)
          .flex.flex-wrap.gap-3
            - options.each do |option|
              = toggle_switch_tag "course[prerequisite_course_ids][]",
                  label: option.title,
                  value: option.id,
                  checked: course.prerequisite_course_ids.include?(option.id),
                  include_hidden: false,
                  id: "course_prerequisite_course_ids_#{option.id}",
                  wrapper_class: "inline-flex items-center gap-2"
