.grid.grid-cols-1.gap-4
  .flex.flex-col.gap-4.sm:flex-row.sm:items-start
    %div.flex-1.min-w-0
      = f.label :title, class: "block text-sm font-medium mb-1"
      = f.text_field :title, class: "w-full border border-gray-300 rounded px-3 py-2"

    %div.sm:w-48
      = f.label :locale, class: "block text-sm font-medium mb-1"
      = f.select :locale, User::SUPPORTED_LOCALES.map { |code, label| [label, code] }, {}, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"

  %div
    = f.label :description, class: "block text-sm font-medium mb-1"
    = f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded px-3 py-2"

  .flex.flex-col.gap-4.sm:flex-row.sm:items-end
    - if subjects_enabled?
      %div.flex-1
        = f.label :subject_id, "Subject", class: "block text-sm font-medium mb-1"
        = f.collection_select :subject_id, Subject.order(:name), :id, :name, { include_blank: admin ? "—" : "Select a subject" }, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"

    - if admin
      %div.flex-1
        = f.label :owner_id, "Owner", class: "block text-sm font-medium mb-1"
        = f.collection_select :owner_id, User.order(:email), :id, :email, { include_blank: "—" }, class: "w-full border border-gray-300 rounded px-3 py-2 bg-white"

    %div.flex-1
      = f.label :published_at, "Publish at", class: "block text-sm font-medium mb-1"
      = f.datetime_local_field :published_at, title: "Leave blank to keep this course as a draft.", class: "w-full border border-gray-300 rounded px-3 py-2"

    %div.flex-1.pb-2
      = toggle_switch_field f, :public_access_enabled,
          label: "Allow public access",
          title: "Published courses with public access can be viewed by people who are not signed in, including their lessons and uploaded content."

  %div
    = upload_field f, :cover_image,
        label: "Upload cover image (PNG, JPG or WebP, max 5 MB)",
        accept: "image/png,image/jpeg,image/webp",
        current_attachment: course.cover_image,
        remove_name: "course[remove_cover_image]",
        remove_label: "Remove current cover image",
        hint: "Cover image (optional)"

  %div
    = render "shared/tag_picker", f: f, record: course

  - options = Course.prerequisite_options_for(current_user, except: course)
  - if options.any?
    %div
      %p.block.text-sm.font-medium.mb-1 Complete these courses first (milestones)
      %p.text-xs.text-gray-500.mb-2 Students must finish every selected course before they can enrol here.
      .max-h-48.overflow-y-auto.border.border-gray-200.rounded.p-2.space-y-1
        - options.each do |option|
          %label.flex.items-center.gap-2.text-sm.cursor-pointer
            = check_box_tag "course[prerequisite_course_ids][]", option.id, course.prerequisite_course_ids.include?(option.id), id: "course_prerequisite_course_ids_#{option.id}", class: "rounded border-gray-300"
            %span= option.title
            - unless option.published?
              %span.text-xs.text-amber-700 (draft)
      = hidden_field_tag "course[prerequisite_course_ids][]", ""
