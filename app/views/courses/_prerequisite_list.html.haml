%p.mb-4.text-gray-700= "To enrol in this course, please first complete the following #{'course'.pluralize(missing.size)}:"
%ul.flex.flex-wrap.gap-2.list-none
  - missing.each do |prereq|
    %li= link_to prereq.title, course_path(prereq), class: "inline-flex items-center px-3 py-1.5 rounded-full text-sm font-medium bg-indigo-600 text-white hover:bg-indigo-700 transition-colors"
