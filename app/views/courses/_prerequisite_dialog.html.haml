.fixed.inset-0.z-50.hidden{ id: "course-prerequisites-dialog", data: { controller: "dialog", dialog_open_value: "false" }, role: "dialog", "aria-modal": "true", "aria-labelledby": "course-prerequisites-title", "aria-hidden": "true" }
