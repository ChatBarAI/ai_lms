!!!
%html{ lang: I18n.locale.to_s, class: theme_mode_class }
  %head
    %title= "Admin · #{content_for(:title) || "AI LMS"}"
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %meta{ name: "app-revision", content: AppVersion.revision }
    = csrf_meta_tags
    = csp_meta_tag
    = yield :head
    = site_favicon_link_tag
    = stylesheet_link_tag "tailwind", "data-turbo-track": "reload"
    -# Keep tracked asset markup stable: changing media on load forces Turbo to reload.
    = stylesheet_link_tag "application", "data-turbo-track": "reload"
    = javascript_importmap_tags
    = yield :javascript
    = theme_style_tag
    = theme_mode_script
  %body{ class: "bg-[var(--page-bg)] text-[var(--page-fg)]", data: { controller: "admin-sidebar" } }
    = render "shared/time_zone"
    = render "admin/sidebar"
    .admin-content
      %header.sticky.top-0.z-40.flex.items-center.gap-3.px-4.py-2.lg:hidden{ class: "bg-[var(--admin-nav-bg)] text-[var(--admin-nav-fg)]" }
        %button.inline-flex.h-9.w-9.shrink-0.items-center.justify-center.rounded-md.cursor-pointer{ class: "hover:bg-current/10", type: "button", "aria-controls": "admin-sidebar", "aria-expanded": "false", "aria-label": "Open admin menu", data: { action: "admin-sidebar#toggle", admin_sidebar_target: "openButton" } }
          = admin_nav_icon(:menu)
        = link_to admin_root_path, class: "flex min-w-0 items-center gap-2 [&_img]:max-w-[10rem] [&_img]:object-contain" do
          = site_logo_tag
          %span.text-sm.font-semibold Admin
      %main.max-w-6xl.mx-auto.px-4.py-2.lg:py-6
        - flash.each do |type, msg|
          - level = (type.to_s == "notice" ? "bg-green-50 text-green-800 border-green-200" : "bg-amber-50 text-amber-800 border-amber-200")
          .mb-4.px-4.py-2.border.rounded{ class: level }
            = msg
        = yield
