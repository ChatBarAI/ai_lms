#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
  cat <<'USAGE'
Usage:
  bin/check-deploy USER@HOST [GIT_REF]

USER@HOST is required. Defaults: SSH_PORT=22, local main.
Examples:
  bin/check-deploy root@server.example.com
  SSH_PORT=2222 bin/check-deploy root@server.example.com main
  bin/check-deploy root@server.example.com HEAD

Read-only: compares web/worker container image tags with a local Git commit
and checks that both containers are running. Does not fetch or deploy code.
Exit codes: 0 = matching and running, 1 = mismatch or not running, 2 = check failed.
USAGE
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  usage
  exit 0
fi
[[ $# -ge 1 && $# -le 2 ]] || { usage >&2; exit 2; }

target=$1
ref=${2:-main}
ssh_port=${SSH_PORT:-22}
[[ $target =~ ^[A-Za-z_][A-Za-z0-9_-]*@[A-Za-z0-9.-]+$ ]] || {
  echo "Target must have the form USER@HOST." >&2
  exit 2
}
[[ $ssh_port =~ ^[0-9]{1,5}$ ]] && (( 10#$ssh_port >= 1 && 10#$ssh_port <= 65535 )) || {
  echo "SSH_PORT must be between 1 and 65535." >&2
  exit 2
}

project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
if ! commit=$(git -C "$project_root" rev-parse --verify --end-of-options "${ref}^{commit}"); then
  echo "Cannot resolve local Git ref: $ref" >&2
  exit 2
fi
echo "Expected ($ref): $commit"
echo "Checking $target on SSH port $ssh_port..."
if ! containers=$(ssh -p "$ssh_port" -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 "$target" \
  "docker inspect --format '{{.Name}}|{{.Config.Image}}|{{.State.Status}}|{{.State.StartedAt}}' ai_lms-web-1 ai_lms-worker-1"); then
  echo "Check failed: could not inspect both production containers." >&2
  exit 2
fi

result=0
declare -A seen=()
while IFS='|' read -r name image status started; do
  case "$name" in
    /ai_lms-web-1|/ai_lms-worker-1) ;;
    *) echo "Check failed: unexpected Docker output." >&2; exit 2 ;;
  esac
  if [[ -n ${seen[$name]:-} || -z $image || -z $status || -z $started ]]; then
    echo "Check failed: incomplete or duplicate Docker output." >&2
    exit 2
  fi
  seen[$name]=1
  echo "${name#/}: $image ($status; started $started)"
  if [[ $image != "ai_lms:$commit" || $status != running ]]; then
    result=1
  fi
done <<< "$containers"

if [[ ${#seen[@]} -ne 2 ]]; then
  echo "Check failed: did not receive both production containers." >&2
  exit 2
fi
if [[ $result -eq 0 ]]; then
  echo "MATCH: both running containers are tagged with local $ref ($commit)."
else
  echo "MISMATCH: a container has a different image tag or is not running."
fi
exit "$result"
