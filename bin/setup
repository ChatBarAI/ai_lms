#!/usr/bin/env ruby
require "fileutils"
require "etc"
require "optparse"
require "uri"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def database_root_from_directory
  sanitize_database_root(File.basename(APP_ROOT))
end

def sanitize_database_root(name)
  name.to_s.gsub(/[^a-zA-Z0-9_]/, "_").gsub(/_+/, "_").sub(/\A_+|_+\z/, "").then do |sanitized|
    sanitized.empty? ? "ai_lms" : sanitized
  end
end

def prompt_with_default(label, default)
  return default unless $stdin.tty?

  print "#{label} [#{default}]: "
  answer = $stdin.gets&.strip
  answer.nil? || answer.empty? ? default : answer
end

def prompt_required(label)
  return nil unless $stdin.tty?

  print "#{label}: "
  $stdin.gets&.strip
end

def app_url_for_nginx(options)
  options[:app_url] || prompt_required("Public app URL for Nginx, e.g. https://learn.example.com")
end

def app_owner
  Etc.getpwuid(File.stat(APP_ROOT).uid).name
rescue ArgumentError
  ENV.fetch("USER", "bl")
end

def nginx_upstream_name(app_name)
  app_name.gsub(/[^a-zA-Z0-9_]/, "_")
end

def domain_from_url(url)
  return nil if url.to_s.strip.empty?

  URI.parse(url).host
rescue URI::InvalidURIError
  nil
end

def write_file(path, content)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, content)
  puts "  # wrote #{path}"
end

def production_environment(database_root:, database_user:, app_url: nil)
  env = {
    "RAILS_ENV" => "production",
    "AI_LMS_DATABASE_ROOT" => database_root,
    "AI_LMS_DATABASE_NAME" => "#{database_root}_production",
    "AI_LMS_DATABASE_USERNAME" => database_user
  }

  if app_url.to_s.strip != ""
    env["APP_HOST"] = app_url
    env["CALLBACK_HOST"] = app_url
  end

  env
end

def rails_environment_lines(database_root:, database_user:, app_url: nil)
  production_environment(database_root: database_root, database_user: database_user, app_url: app_url).map do |key, value|
    "Environment=#{key}=#{value}"
  end.join("\n")
end

def production_rails_env_prefix(database_root:, database_user:, app_url: nil)
  production_environment(database_root: database_root, database_user: database_user, app_url: app_url).map do |key, value|
    "#{key}=#{value}"
  end.join(" ")
end

def puma_systemd_unit(app_name:, database_root:, deploy_user:, database_user:, app_url: nil)
  <<~UNIT
    [Unit]
    Description=Puma HTTP Server for #{app_name}
    After=network.target postgresql.service
    Wants=network.target

    [Service]
    Type=simple
    User=#{deploy_user}
    Group=#{deploy_user}
    WorkingDirectory=#{APP_ROOT}

    RuntimeDirectory=#{app_name}
    RuntimeDirectoryMode=0750

    #{rails_environment_lines(database_root: database_root, database_user: database_user, app_url: app_url)}
    Environment=PUMA_BIND=unix:///run/#{app_name}/puma.sock
    Environment=PIDFILE=/run/#{app_name}/puma.pid

    ExecStart=/usr/bin/env bundle exec puma -C config/puma.rb
    ExecReload=/bin/kill -USR2 $MAINPID

    Restart=always
    RestartSec=3
    KillMode=process
    TimeoutStopSec=30

    NoNewPrivileges=true

    [Install]
    WantedBy=multi-user.target
  UNIT
end

def sidekiq_systemd_unit(app_name:, database_root:, deploy_user:, database_user:, app_url: nil)
  <<~UNIT
    [Unit]
    Description=Sidekiq Worker for #{app_name}
    After=network.target postgresql.service redis-server.service
    Wants=network.target

    [Service]
    Type=simple
    User=#{deploy_user}
    Group=#{deploy_user}
    WorkingDirectory=#{APP_ROOT}

    #{rails_environment_lines(database_root: database_root, database_user: database_user, app_url: app_url)}

    ExecStart=/usr/bin/env bundle exec sidekiq

    Restart=always
    RestartSec=3
    TimeoutStopSec=30

    StandardOutput=append:#{APP_ROOT}/log/sidekiq.log
    StandardError=append:#{APP_ROOT}/log/sidekiq.log

    NoNewPrivileges=true

    [Install]
    WantedBy=multi-user.target
  UNIT
end

def nginx_bootstrap_config(app_name:, domain:)
  upstream_name = nginx_upstream_name(app_name)

  <<~NGINX
    # Bootstrap config for first certificate issuance.
    # Install this before running:
    #   sudo certbot certonly --webroot -w /var/www/certbot -d #{domain}

    upstream #{upstream_name} {
        server unix:/run/#{app_name}/puma.sock fail_timeout=0;
    }

    server {
        listen 80;
        server_name #{domain};

        root #{APP_ROOT}/public;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        try_files $uri/index.html $uri @app;

        location @app {
            proxy_pass http://#{upstream_name};
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
        }

        access_log /var/log/nginx/#{app_name}.access.log;
        error_log  /var/log/nginx/#{app_name}.error.log;
        client_max_body_size 50M;
        keepalive_timeout 10;
    }
  NGINX
end

def nginx_ssl_config(app_name:, domain:)
  upstream_name = nginx_upstream_name(app_name)

  <<~NGINX
    # ssl certificate and key are managed by certbot.
    #
    # Nginx restart with:
    #   sudo systemctl restart nginx
    #
    # Puma restart with:
    #   sudo systemctl restart puma-#{app_name}

    upstream #{upstream_name} {
        server unix:/run/#{app_name}/puma.sock fail_timeout=0;
    }

    server {
        server_name #{domain};

        root #{APP_ROOT}/public;

        try_files $uri/index.html $uri @app;

        location /cable {
            proxy_pass http://#{upstream_name};
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;
            proxy_read_timeout 86400s;
            proxy_send_timeout 86400s;
        }

        location @app {
            proxy_pass http://#{upstream_name};
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_redirect off;

            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization';
            add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range';

            if ($request_method = 'OPTIONS') {
                add_header 'Access-Control-Allow-Origin' '*';
                add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
                add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization';
                add_header 'Access-Control-Max-Age' 1728000;
                add_header 'Content-Type' 'text/plain; charset=utf-8';
                add_header 'Content-Length' 0;
                return 204;
            }
        }

        access_log /var/log/nginx/#{app_name}.access.log;
        error_log  /var/log/nginx/#{app_name}.error.log;

        error_page 500 502 503 504 /500.html;
        client_max_body_size 50M;
        keepalive_timeout 10;

        listen 443 ssl http2;
        include /etc/letsencrypt/options-ssl-nginx.conf;
        ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

        ssl_certificate /etc/letsencrypt/live/#{domain}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/#{domain}/privkey.pem;
    }

    server {
        if ($host = #{domain}) {
            return 301 https://$host$request_uri;
        }

        listen 80;
        server_name #{domain};
        return 404;
    }
  NGINX
end

def generate_deploy_configs(options, database_root)
  app_name = sanitize_database_root(database_root)
  deploy_user = options[:deploy_user] || app_owner
  database_user = options[:db_user] || deploy_user
  output_dir = File.expand_path(options[:deploy_config_dir] || "config/deploy/generated", APP_ROOT)

  puts "\n== Generating deploy config =="

  if options[:generate_systemd]
    puma_path = File.join(output_dir, "puma-#{app_name}.service")
    sidekiq_path = File.join(output_dir, "sidekiq-#{app_name}.service")
    write_file(puma_path, puma_systemd_unit(app_name: app_name, database_root: database_root, deploy_user: deploy_user, database_user: database_user, app_url: options[:app_url]))
    write_file(sidekiq_path, sidekiq_systemd_unit(app_name: app_name, database_root: database_root, deploy_user: deploy_user, database_user: database_user, app_url: options[:app_url]))
    puts "  # Prepare production database before starting services"
    puts "  #{production_rails_env_prefix(database_root: database_root, database_user: database_user, app_url: options[:app_url])} bin/rails db:prepare"
    puts "  # If the PostgreSQL role cannot create the database, create it once with:"
    puts "  # sudo -u postgres createdb -O #{database_user} #{database_root}_production"
    puts "  # Compile production assets"
    puts "  #{production_rails_env_prefix(database_root: database_root, database_user: database_user, app_url: options[:app_url])} bin/rails assets:precompile"
    puts "  # Install and start systemd services"
    puts "  sudo cp #{puma_path} /etc/systemd/system/puma-#{app_name}.service"
    puts "  sudo cp #{sidekiq_path} /etc/systemd/system/sidekiq-#{app_name}.service"
    puts "  sudo systemctl daemon-reload"
    puts "  sudo systemctl enable --now puma-#{app_name}.service"
    puts "  sudo systemctl enable --now sidekiq-#{app_name}.service"
    puts "  sudo systemctl status puma-#{app_name}.service --no-pager -l"
    puts "  sudo systemctl status sidekiq-#{app_name}.service --no-pager -l"
    if options[:app_url].to_s.strip != ""
      puts "  # Kinde application settings must allow these URLs"
      puts "  # Callback URL: #{options[:app_url]}/kinde/callback"
      puts "  # Logout redirect URL: #{options[:app_url]}/kinde/logout_callback"
    end
  end

  return unless options[:generate_nginx]

  app_url = app_url_for_nginx(options)
  domain = domain_from_url(app_url)
  if domain.to_s.empty?
    warn "Nginx config requested, but no valid --app-url was provided."
    exit 1
  end

  bootstrap_path = File.join(output_dir, "#{app_name}.nginx.bootstrap.conf")
  ssl_path = File.join(output_dir, "#{app_name}.nginx.conf")
  write_file(bootstrap_path, nginx_bootstrap_config(app_name: app_name, domain: domain))
  write_file(ssl_path, nginx_ssl_config(app_name: app_name, domain: domain))
  puts "  # First certificate install"
  puts "    sudo mkdir -p /var/www/certbot"
  puts "    sudo cp #{bootstrap_path} /etc/nginx/sites-available/#{app_name}"
  puts "    sudo ln -sf /etc/nginx/sites-available/#{app_name} /etc/nginx/sites-enabled/#{app_name}"
  puts "    sudo nginx -t"
  puts "    sudo systemctl enable --now nginx"
  puts "    sudo systemctl reload nginx"
  puts "    sudo certbot certonly --webroot -w /var/www/certbot -d #{domain}"
  puts "  # After certbot succeeds"
  puts "    sudo cp #{ssl_path} /etc/nginx/sites-available/#{app_name}"
  puts "    sudo nginx -t"
  puts "    sudo systemctl reload nginx"
end

options = {}
default_database_root = database_root_from_directory
default_bundle_path = "vendor/bundle"
OptionParser.new do |opts|
  opts.banner = "Usage: bin/setup [options]"
  opts.separator ""
  opts.separator "Sets up the development environment: installs gems, creates and"
  opts.separator "seeds the database, and clears logs and tmp files."
  opts.separator ""
  opts.separator "Options:"

  opts.on("--db-user USER", "PostgreSQL role to use (default: current OS user)") do |user|
    options[:db_user] = user
  end

  opts.on("--database-root NAME", "Database root name (default: #{default_database_root})") do |name|
    options[:database_root] = name
  end

  opts.on("--bundle-path PATH", "Bundler install path (default: #{default_bundle_path})") do |path|
    options[:bundle_path] = path
  end

  opts.on("--admin-email EMAIL", "Admin account email (default: admin@example.com)") do |email|
    options[:admin_email] = email
  end

  opts.on("--admin-name NAME", "Admin display name (default: Admin)") do |name|
    options[:admin_name] = name
  end

  opts.on("--brand-name NAME", "Site brand name (default: ChatBar AI Learn)") do |name|
    options[:brand_name] = name
  end

  opts.on("--app-url URL", "Public app URL, e.g. https://learn.example.com") do |url|
    options[:app_url] = url
  end

  opts.on("--generate-systemd", "Generate Puma and Sidekiq systemd units under config/deploy/generated") do
    options[:generate_systemd] = true
  end

  opts.on("--generate-nginx", "Generate bootstrap and SSL Nginx configs under config/deploy/generated") do
    options[:generate_nginx] = true
  end

  opts.on("--generate-deploy-configs", "Generate both systemd and Nginx configs") do
    options[:generate_systemd] = true
    options[:generate_nginx] = true
  end

  opts.on("--deploy-configs-only", "Generate requested deploy configs and skip setup tasks") do
    options[:deploy_configs_only] = true
  end

  opts.on("--deploy-config-dir PATH", "Output directory for generated deploy configs (default: config/deploy/generated)") do |path|
    options[:deploy_config_dir] = path
  end

  opts.on("--deploy-user USER", "User/group for generated systemd unit (default: app directory owner)") do |user|
    options[:deploy_user] = user
  end

  opts.on("-h", "--help", "Show this help message") do
    puts opts
    exit
  end
end.parse!

database_root = sanitize_database_root(options[:database_root] || prompt_with_default("Database root name", default_database_root))
bundle_path = options[:bundle_path] || ENV["BUNDLE_PATH"] || default_bundle_path

ENV["PGUSER"]           = options[:db_user]    if options[:db_user]
ENV["AI_LMS_DATABASE_ROOT"] = database_root
ENV["SEED_ADMIN_EMAIL"] = options[:admin_email] if options[:admin_email]
ENV["SEED_ADMIN_NAME"]  = options[:admin_name]  if options[:admin_name]
ENV["SEED_BRAND_NAME"]  = options[:brand_name]  if options[:brand_name]
ENV["SEED_APP_URL"]     = options[:app_url]     if options[:app_url]

puts "== Using PostgreSQL user: #{options[:db_user]} ==" if options[:db_user]
puts "== Using database root: #{database_root} =="
puts "   development: #{database_root}_development"
puts "   test:        #{database_root}_test"
puts "   production:  #{database_root}_production"
puts "== Using Bundler path: #{bundle_path} =="

if options[:deploy_configs_only]
  if !options[:generate_systemd] && !options[:generate_nginx]
    options[:generate_systemd] = true
    options[:generate_nginx] = true
  end

  generate_deploy_configs(options, database_root)
  exit
end

# ── System dependency preflight ──────────────────────────────────────────────
FAIL = "\e[31m✗\e[0m"
OK   = "\e[32m✓\e[0m"
WARN = "\e[33m⚠\e[0m"

def check(label, *cmds, required: true)
  found = cmds.any? { |c| system("command -v #{c} > /dev/null 2>&1") }
  if found
    puts "  #{OK}  #{label}"
  elsif required
    puts "  #{FAIL}  #{label}  ← REQUIRED (install and re-run)"
    @preflight_failed = true
  else
    puts "  #{WARN}  #{label}  (optional — needed in production)"
  end
end

puts "\n== Checking system dependencies =="
check "PostgreSQL (psql)",    "psql"
check "libvips (vips)",       "vips"        # ActiveStorage image variants
check "ImageMagick (convert)","convert"     # PWA icon generation
check "Redis (redis-cli)",    "redis-cli",  required: false

if @preflight_failed
  puts "\nAborting: install the missing dependencies above and re-run bin/setup."
  exit 1
end
# ─────────────────────────────────────────────────────────────────────────────

FileUtils.chdir APP_ROOT do
  puts "\n== Installing dependencies =="
  system("bundle --version > /dev/null 2>&1") || system!("gem", "install", "bundler", "--conservative", "--user-install")
  system! "bundle", "config", "set", "--local", "path", bundle_path
  system("bundle check") || system!("bundle install")

  generated_deploy_configs = options[:generate_systemd] || options[:generate_nginx]
  database_user = options[:db_user] || app_owner

  if generated_deploy_configs
    puts "\n== Preparing production database =="
    system! production_environment(database_root: database_root, database_user: database_user, app_url: options[:app_url]), "bin/rails", "db:prepare"
    puts "\n== Compiling production assets =="
    system! production_environment(database_root: database_root, database_user: database_user, app_url: options[:app_url]), "bin/rails", "assets:precompile"
  else
    puts "\n== Preparing database =="
    system! "bin/rails db:prepare"
  end

  puts "\n== Removing old logs and tempfiles =="
  system! "bin/rails log:clear tmp:clear"

  generate_deploy_configs(options, database_root) if generated_deploy_configs

  if generated_deploy_configs
    puts "\n== Setup complete! Follow the generated commands above to install/start the production services. =="
  else
    puts "\n== Setup complete! For local development, run 'bin/dev' to start the development server. =="
  end
end
