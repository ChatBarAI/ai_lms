#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

usage() {
  cat <<'USAGE'
Usage:
  deploy/restore --force CLONE_BUNDLE

This completely replaces the target database and Active Storage files.
Accepts the single .tar.gz archive produced by deploy/backup or deploy/export.
For isolated local testing with Docker and PostgreSQL 16 instead, use:
  bin/local-clone restore --force CLONE_BUNDLE
Run on the DESTINATION machine in a prepared checkout/deployment. Install the
matching or compatible newer application code, dependencies, database, and
required Rails keys first. Native PostgreSQL client tools must be compatible
with the source database (the Docker deployment uses PostgreSQL 16).

Docker: stops web/worker/proxy, restores data, migrates, then restarts them.
If restore fails after stopping services, they remain stopped for inspection.
Native: stop Rails/background workers before running; restart after success.
By default, clears copied app_url and redis_url settings for the destination.
Other copied settings and integration credentials remain; review before use.

Environment:
  DEPLOY_MODE=auto|docker|native
  DEPLOY_ROOT=/opt/ai_lms
  RAILS_ENV=production               # native; use development locally
  STORAGE_PATH=/path/to/storage       # native only
  NATIVE_WRITES_STOPPED=1             # required for native restore
  PRESERVE_INSTANCE_SETTINGS=1        # retain source app_url and redis_url

Local development example (Rails and background workers must be stopped):
  RAILS_ENV=development bin/rails db:create
  DEPLOY_MODE=native RAILS_ENV=development NATIVE_WRITES_STOPPED=1 \
    deploy/restore --force /absolute/path/to/ai-lms-clone.tar.gz
  bin/dev

Docker destination example (deploy application code first):
  /opt/ai_lms/current/deploy/restore --force /tmp/ai-lms-clone.tar.gz

Check the destination database configuration, including DATABASE_URL: --force
authorizes replacing its contents and the target storage files.
See deploy/backup --help for backup/download steps, and README.md.
USAGE
}

if [[ ${1:-} == --help ]]; then
  usage
  exit 0
fi

[[ ${1:-} == --force && $# -eq 2 ]] || { usage >&2; exit 2; }

bundle=$(readlink -f "$2")
[[ -f $bundle ]] || { echo "Clone bundle not found: $2" >&2; exit 1; }

app_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
mode=${DEPLOY_MODE:-auto}
deploy_root=${DEPLOY_ROOT:-/opt/ai_lms}
env_file="$deploy_root/shared/.env"
work_dir=$(mktemp -d)
docker_stopped=false
restore_succeeded=false

cleanup() {
  if $docker_stopped && $restore_succeeded; then
    "${compose[@]}" up -d web worker proxy >/dev/null
  fi
  rm -rf -- "$work_dir"
}
trap cleanup EXIT

source "$app_root/deploy/unpack-bundle"

docker_available() {
  command -v docker >/dev/null 2>&1 &&
    [[ -f $env_file && -f "$app_root/compose.yaml" ]]
}

if [[ $mode == auto ]]; then
  if docker_available; then
    mode=docker
  else
    mode=native
  fi
fi

case "$mode" in
  docker)
    docker_available || { echo "Docker deployment configuration was not found." >&2; exit 1; }
    export APP_IMAGE="ai_lms:$(basename "$app_root")"
    compose=(docker compose --env-file "$env_file" -f "$app_root/compose.yaml")

    echo "Stopping the target application..."
    "${compose[@]}" stop web worker proxy
    docker_stopped=true
    "${compose[@]}" up -d db redis

    echo "Replacing PostgreSQL data..."
    "${compose[@]}" exec -T db \
      pg_restore --clean --if-exists --no-owner --no-privileges \
      --exit-on-error -U ai_lms -d ai_lms_production < "$work_dir/database.dump"

    echo "Replacing Active Storage files..."
    docker run --rm \
      -v ai_lms_storage:/target \
      alpine:3.22 sh -c 'find /target -mindepth 1 -delete'
    docker run --rm \
      -v ai_lms_storage:/target \
      -v "$work_dir:/backup:ro" \
      alpine:3.22 sh -c 'tar -xzf /backup/storage.tar.gz -C /target && chown -R 1000:1000 /target && find /target -type d -exec chmod 700 {} + && find /target -type f -exec chmod 600 {} +'

    "${compose[@]}" run --rm web ./bin/rails db:migrate
    if [[ ${PRESERVE_INSTANCE_SETTINGS:-0} != 1 ]]; then
      "${compose[@]}" run --rm web ./bin/rails runner \
        'SiteSetting.update_all(redis_url: nil, app_url: nil)'
    fi
    restore_succeeded=true
    ;;
  native)
    requested_storage_path=$(readlink -m "${STORAGE_PATH:-"$app_root/storage"}")
    [[ $requested_storage_path =~ ^/[A-Za-z0-9._/-]+$ && $requested_storage_path != / ]] ||
      { echo "STORAGE_PATH must be a safe absolute directory other than /." >&2; exit 1; }
    case "$requested_storage_path" in
      /bin|/boot|/dev|/etc|/home|/lib|/lib64|/media|/mnt|/opt|/proc|/root|/run|/sbin|/srv|/sys|/tmp|/usr|/var)
        echo 'STORAGE_PATH is too broad; provide the dedicated uploads directory.' >&2; exit 1 ;;
    esac
    [[ $app_root != "$requested_storage_path" && $app_root != "$requested_storage_path/"* &&
       $bundle != "$requested_storage_path/"* && $work_dir != "$requested_storage_path/"* ]] || {
      echo 'STORAGE_PATH must not contain the app, backup archive, or restore staging directory.' >&2
      exit 1
    }
    command -v pg_restore >/dev/null 2>&1 || { echo "pg_restore is required." >&2; exit 1; }
    [[ ${NATIVE_WRITES_STOPPED:-0} == 1 ]] || {
      echo "Stop Puma and Sidekiq, then run with NATIVE_WRITES_STOPPED=1." >&2
      exit 1
    }

    echo "Replacing PostgreSQL data..."
    (
      cd "$app_root"
      RAILS_ENV=${RAILS_ENV:-production} bin/rails runner \
        deploy/database_transfer.rb restore "$work_dir/database.dump"
    )

    echo "Replacing Active Storage files..."
    mkdir -p "$requested_storage_path"
    storage_path=$(readlink -f "$requested_storage_path")
    [[ $storage_path != / ]] ||
      { echo "STORAGE_PATH resolved to an unsafe directory." >&2; exit 1; }
    find "$storage_path" -mindepth 1 -delete
    tar --no-same-owner --no-same-permissions \
      -xzf "$work_dir/storage.tar.gz" -C "$storage_path"
    find "$storage_path" -type d -exec chmod 700 {} +
    find "$storage_path" -type f -exec chmod 600 {} +
    (
      cd "$app_root"
      RAILS_ENV=${RAILS_ENV:-production} bin/rails db:migrate
    )
    if [[ ${PRESERVE_INSTANCE_SETTINGS:-0} != 1 ]]; then
      (
        cd "$app_root"
        RAILS_ENV=${RAILS_ENV:-production} bin/rails runner \
          'SiteSetting.update_all(redis_url: nil, app_url: nil)'
      )
    fi
    restore_succeeded=true
    ;;
  *)
    echo "DEPLOY_MODE must be auto, docker, or native." >&2
    exit 2
    ;;
esac

echo "Clone restored successfully."
if [[ $mode == native ]]; then
  echo "Restart the native Puma and Sidekiq services now."
fi
